// ============================================================================
// JOGO DA COBRINHA (SNAKE GAME) - VAMOS-LANG
// Um clássico arcade implementado 100% com sintaxe em Português do Brasil.
// Inclui maçã comum (★), fruta dourada especial bônus (✪), sistema de pontuação,
// IA inteligente para modo demonstração (--demo) e controle interativo.
// ============================================================================

pacote principal

importar (
	"cordas"
	"formatar"
	"leitor"
	"matematica/aleatorio"
	"so"
	"tempo"
)

// Ponto representa uma coordenada cartesiana na grade 2D
tipo Ponto estrutura {
	X inteiro
	Y inteiro
}

// Constantes de Direção
constante (
	DirCima     inteiro = 1
	DirBaixo    inteiro = 2
	DirEsquerda inteiro = 3
	DirDireita  inteiro = 4
)

// JogoCobrinha gerencia o estado completo da partida
tipo JogoCobrinha estrutura {
	Largura           inteiro
	Altura            inteiro
	Corpo             []Ponto
	DirecaoAtual      inteiro
	Comida            Ponto
	ComidaDourada     Ponto
	TemComidaDourada  booleano
	TempoDouradaRest  inteiro
	ComidasColetadas  inteiro
	Pontuacao         inteiro
	Recorde           inteiro
	FimDeJogo         booleano
	Vitoria           booleano
	ModoDemo          booleano
	PassosTotais      inteiro
	NivelVelocidade   texto
}

// NovoJogoCobrinha inicializa a cobrinha centralizada e a primeira maçã
funcao NovoJogoCobrinha(largura inteiro, altura inteiro, modoDemo booleano, nivel texto) *JogoCobrinha {
	centroX := largura / 2
	centroY := altura / 2

	// Inicializa a cobra com 3 segmentos
	corpoInicial := criar([]Ponto, 0)
	corpoInicial = adicionar(corpoInicial, Ponto{X: centroX - 2, Y: centroY})
	corpoInicial = adicionar(corpoInicial, Ponto{X: centroX - 1, Y: centroY})
	corpoInicial = adicionar(corpoInicial, Ponto{X: centroX, Y: centroY})

	jogo := &JogoCobrinha{
		Largura:          largura,
		Altura:           altura,
		Corpo:            corpoInicial,
		DirecaoAtual:     DirDireita,
		TemComidaDourada: falso,
		TempoDouradaRest: 0,
		ComidasColetadas: 0,
		Pontuacao:        0,
		Recorde:          100,
		FimDeJogo:        falso,
		Vitoria:          falso,
		ModoDemo:         modoDemo,
		PassosTotais:     0,
		NivelVelocidade:  nivel,
	}

	jogo.GerarNovaComida()
	retornar jogo
}

// PosicaoOcupadaPelaCobra verifica se uma coordenada coincide com o corpo
funcao (j *JogoCobrinha) PosicaoOcupadaPelaCobra(x inteiro, y inteiro) booleano {
	para i := 0; i < tamanho(j.Corpo); i++ {
		se j.Corpo[i].X == x && j.Corpo[i].Y == y {
			retornar verdadeiro
		}
	}
	retornar falso
}

// GerarNovaComida posiciona uma fruta comum (★) em casa livre
funcao (j *JogoCobrinha) GerarNovaComida() {
	tentativas := 0
	para tentativas < 1000 {
		cx := aleatorio.InteiroAte(j.Largura)
		cy := aleatorio.InteiroAte(j.Altura)
		se !j.PosicaoOcupadaPelaCobra(cx, cy) && (!j.TemComidaDourada || cx != j.ComidaDourada.X || cy != j.ComidaDourada.Y) {
			j.Comida = Ponto{X: cx, Y: cy}
			retornar
		}
		tentativas++
	}
	// Se todo o tabuleiro estiver ocupado, o jogador venceu
	j.Vitoria = verdadeiro
	j.FimDeJogo = verdadeiro
}

// GerarComidaDourada posiciona uma fruta especial bônus (✪)
funcao (j *JogoCobrinha) GerarComidaDourada() {
	tentativas := 0
	para tentativas < 1000 {
		cx := aleatorio.InteiroAte(j.Largura)
		cy := aleatorio.InteiroAte(j.Altura)
		se !j.PosicaoOcupadaPelaCobra(cx, cy) && (cx != j.Comida.X || cy != j.Comida.Y) {
			j.ComidaDourada = Ponto{X: cx, Y: cy}
			j.TemComidaDourada = verdadeiro
			j.TempoDouradaRest = 15 // dura 15 turnos
			retornar
		}
		tentativas++
	}
}

// ObterCabeca retorna a coordenada atual da cabeça da cobrinha
funcao (j *JogoCobrinha) ObterCabeca() Ponto {
	retornar j.Corpo[tamanho(j.Corpo)-1]
}

// MudarDirecao altera o vetor de movimento evitando reversão de 180 graus
funcao (j *JogoCobrinha) MudarDirecao(novaDir inteiro) {
	se novaDir == DirCima && j.DirecaoAtual != DirBaixo {
		j.DirecaoAtual = DirCima
	} senao se novaDir == DirBaixo && j.DirecaoAtual != DirCima {
		j.DirecaoAtual = DirBaixo
	} senao se novaDir == DirEsquerda && j.DirecaoAtual != DirDireita {
		j.DirecaoAtual = DirEsquerda
	} senao se novaDir == DirDireita && j.DirecaoAtual != DirEsquerda {
		j.DirecaoAtual = DirDireita
	}
}

// ContarEspacosLivresAdjacentes avalia se mover para (x, y) deixa espaço para manobra
funcao (j *JogoCobrinha) ContarEspacosLivresAdjacentes(x inteiro, y inteiro) inteiro {
	vizinhos := []Ponto{{x + 1, y}, {x - 1, y}, {x, y + 1}, {x, y - 1}}
	livres := 0
	para i := 0; i < tamanho(vizinhos); i++ {
		p := vizinhos[i]
		se p.X >= 0 && p.X < j.Largura && p.Y >= 0 && p.Y < j.Altura {
			se !j.PosicaoOcupadaPelaCobra(p.X, p.Y) {
				livres++
			}
		}
	}
	retornar livres
}

// DecidirProximoPassoDemo calcula movimento inteligente autônomo da cobra
funcao (j *JogoCobrinha) DecidirProximoPassoDemo() {
	cabeca := j.ObterCabeca()

	// Se houver maçã dourada ativa, foca nela
	alvo := j.Comida
	se j.TemComidaDourada {
		alvo = j.ComidaDourada
	}

	dx := alvo.X - cabeca.X
	dy := alvo.Y - cabeca.Y

	direcoesCandidatas := criar([]inteiro, 0)

	// 1. Prioriza o eixo com maior distância até a comida
	se dx > 0 && j.DirecaoAtual != DirEsquerda {
		direcoesCandidatas = adicionar(direcoesCandidatas, DirDireita)
	} senao se dx < 0 && j.DirecaoAtual != DirDireita {
		direcoesCandidatas = adicionar(direcoesCandidatas, DirEsquerda)
	}

	se dy > 0 && j.DirecaoAtual != DirCima {
		direcoesCandidatas = adicionar(direcoesCandidatas, DirBaixo)
	} senao se dy < 0 && j.DirecaoAtual != DirBaixo {
		direcoesCandidatas = adicionar(direcoesCandidatas, DirCima)
	}

	// 2. Adiciona as direções restantes como alternativa de segurança
	todasDirs := []inteiro{DirDireita, DirBaixo, DirEsquerda, DirCima}
	para i := 0; i < tamanho(todasDirs); i++ {
		d := todasDirs[i]
		jaContem := falso
		para c := 0; c < tamanho(direcoesCandidatas); c++ {
			se direcoesCandidatas[c] == d {
				jaContem = verdadeiro
				interromper
			}
		}
		se !jaContem {
			direcoesCandidatas = adicionar(direcoesCandidatas, d)
		}
	}

	melhorDir := j.DirecaoAtual
	maiorEspaco := -1

	// Escolhe a direção válida que maximize os espaços livres para não encurralar
	para i := 0; i < tamanho(direcoesCandidatas); i++ {
		dir := direcoesCandidatas[i]
		novoX := cabeca.X
		novoY := cabeca.Y

		se dir == DirCima {
			novoY--
		} senao se dir == DirBaixo {
			novoY++
		} senao se dir == DirEsquerda {
			novoX--
		} senao se dir == DirDireita {
			novoX++
		}

		// Checa se fica dentro dos limites e não colide com o corpo
		se novoX >= 0 && novoX < j.Largura && novoY >= 0 && novoY < j.Altura {
			se !j.PosicaoOcupadaPelaCobra(novoX, novoY) {
				espaco := j.ContarEspacosLivresAdjacentes(novoX, novoY)
				// Se move em direção ao alvo, ganha bônus de peso
				se (dx > 0 && dir == DirDireita) || (dx < 0 && dir == DirEsquerda) ||
				(dy > 0 && dir == DirBaixo) || (dy < 0 && dir == DirCima) {
					espaco += 2
				}

				se espaco > maiorEspaco {
					maiorEspaco = espaco
					melhorDir = dir
				}
			}
		}
	}

	j.MudarDirecao(melhorDir)
}

// AvancarTurno executa um passo físico na simulação
funcao (j *JogoCobrinha) AvancarTurno() {
	se j.FimDeJogo {
		retornar
	}

	// Atualiza temporizador de comida dourada
	se j.TemComidaDourada {
		j.TempoDouradaRest--
		se j.TempoDouradaRest <= 0 {
			j.TemComidaDourada = falso
		}
	}

	se j.ModoDemo {
		j.DecidirProximoPassoDemo()
	}

	cabeca := j.ObterCabeca()
	novoX := cabeca.X
	novoY := cabeca.Y

	se j.DirecaoAtual == DirCima {
		novoY--
	} senao se j.DirecaoAtual == DirBaixo {
		novoY++
	} senao se j.DirecaoAtual == DirEsquerda {
		novoX--
	} senao se j.DirecaoAtual == DirDireita {
		novoX++
	}

	// 1. Checa Colisão com Paredes
	se novoX < 0 || novoX >= j.Largura || novoY < 0 || novoY >= j.Altura {
		j.FimDeJogo = verdadeiro
		retornar
	}

	// 2. Checa Colisão com o Próprio Corpo
	se j.PosicaoOcupadaPelaCobra(novoX, novoY) {
		j.FimDeJogo = verdadeiro
		retornar
	}

	novaCabeca := Ponto{X: novoX, Y: novoY}
	j.Corpo = adicionar(j.Corpo, novaCabeca)
	j.PassosTotais++

	cresceu := falso

	// 3. Checa se Comeu Maçã Comum (★)
	se novoX == j.Comida.X && novoY == j.Comida.Y {
		j.Pontuacao += 10
		j.ComidasColetadas++
		cresceu = verdadeiro
		j.GerarNovaComida()

		// A cada 4 maçãs comuns, chance de surgir maçã dourada especial
		se j.ComidasColetadas%4 == 0 && !j.TemComidaDourada {
			j.GerarComidaDourada()
		}
	}

	// 4. Checa se Comeu Fruta Dourada Especial (✪)
	se j.TemComidaDourada && novoX == j.ComidaDourada.X && novoY == j.ComidaDourada.Y {
		j.Pontuacao += 50
		j.TemComidaDourada = falso
		cresceu = verdadeiro
	}

	// Se não comeu nenhuma fruta, remove cauda para manter o mesmo tamanho
	se !cresceu {
		j.Corpo = j.Corpo[1:]
	}

	se j.Pontuacao > j.Recorde {
		j.Recorde = j.Pontuacao
	}
}

// Renderizar desenha o estado visual da grade no terminal com bordas e ícones
funcao (j *JogoCobrinha) Renderizar() {
	// Borda superior
	formatar.ImprimirLinha("┌" + cordas.Repetir("──", j.Largura) + "┐")

	cabeca := j.ObterCabeca()

	para y := 0; y < j.Altura; y++ {
		linha := "│"
		para x := 0; x < j.Largura; x++ {
			se x == cabeca.X && y == cabeca.Y {
				linha += "◉ " // Cabeça da cobra
			} senao se j.TemComidaDourada && x == j.ComidaDourada.X && y == j.ComidaDourada.Y {
				linha += "✪ " // Fruta Dourada Especial
			} senao se x == j.Comida.X && y == j.Comida.Y {
				linha += "★ " // Maçã Comum
			} senao se j.PosicaoOcupadaPelaCobra(x, y) {
				linha += "○ " // Corpo da cobra
			} senao {
				linha += "  " // Vazio
			}
		}
		linha += "│"
		formatar.ImprimirLinha(linha)
	}

	// Borda inferior
	formatar.ImprimirLinha("└" + cordas.Repetir("──", j.Largura) + "┘")

	statusDourada := ""
	se j.TemComidaDourada {
		statusDourada = formatar.Formatar(" | ✪ Bônus Dourado (+50): %d turnos!", j.TempoDouradaRest)
	}

	formatar.ImprimirFormatado(
		" Pontuação: %d pts | Recorde: %d | Tamanho: %d | Dificuldade: %s%s\n",
		j.Pontuacao, j.Recorde, tamanho(j.Corpo), j.NivelVelocidade, statusDourada,
	)
}

funcao principal() {
	aleatorio.Semente(tempo.Agora().Unix())

	largura := 18
	altura := 10
	modoDemo := falso
	maxPassosDemo := 30
	nivel := "Normal"

	// Analisa flags de linha de comando
	para i := 0; i < tamanho(so.Argumentos); i++ {
		arg := so.Argumentos[i]
		se arg == "--demo" || arg == "-d" || arg == "--simular" {
			modoDemo = verdadeiro
		} senao se arg == "--rapido" || arg == "-r" {
			nivel = "Rápido"
		} senao se arg == "--insano" {
			nivel = "Insano"
		}
	}

	formatar.ImprimirLinha("==================================================")
	formatar.ImprimirLinha("      🐍 JOGO DA COBRINHA (VAMOS-LANG) 🇧🇷         ")
	formatar.ImprimirLinha("==================================================")

	se modoDemo {
		formatar.ImprimirLinha("Modo: Demonstração Autônoma (IA Tática com Heurística)")
		formatar.ImprimirLinha("Itens: ★ Maçã Normal (+10 pts) | ✪ Fruta Dourada (+50 pts)")
		formatar.ImprimirLinha("--------------------------------------------------")

		jogo := NovoJogoCobrinha(largura, altura, verdadeiro, nivel)

		para passo := 1; passo <= maxPassosDemo; passo++ {
			jogo.AvancarTurno()
			formatar.ImprimirFormatado("\n--- Turno %d de %d ---\n", passo, maxPassosDemo)
			jogo.Renderizar()

			se jogo.FimDeJogo {
				formatar.ImprimirLinha("\n[Fim de Jogo] A cobrinha colidiu!")
				interromper
			}

			tempo.Dormir(tempo.Milissegundo * 100)
		}

		formatar.ImprimirLinha("\n==================================================")
		formatar.ImprimirFormatado(" Demonstração Concluída com Sucesso! Pontos: %d ✓\n", jogo.Pontuacao)
		formatar.ImprimirLinha("==================================================")
		retornar
	}

	// Modo Interativo via Terminal
	formatar.ImprimirLinha("Comandos: [W] Cima | [S] Baixo | [A] Esquerda | [D] Direita")
	formatar.ImprimirLinha("Digite [Q] para sair ou pressione Enter para avançar.")
	formatar.ImprimirLinha("Itens: ★ Maçã Normal (+10 pts) | ✪ Fruta Dourada (+50 pts)")
	formatar.ImprimirLinha("Dica: Use '--demo' para assistir ao jogo automático!")
	formatar.ImprimirLinha("--------------------------------------------------")

	jogo := NovoJogoCobrinha(largura, altura, falso, nivel)
	scanner := leitor.NovoScanner(so.EntradaPadrao)

	para !jogo.FimDeJogo {
		jogo.Renderizar()
		formatar.Imprimir("Comando (w/a/s/d/q ou enter): ")

		se !scanner.Escanear() {
			interromper
		}

		entrada := cordas.ParaMinusculas(cordas.ApararEspaco(scanner.ObterTexto()))

		se entrada == "q" || entrada == "sair" {
			formatar.ImprimirLinha("\nPartida encerrada pelo jogador.")
			retornar
		} senao se entrada == "w" {
			jogo.MudarDirecao(DirCima)
		} senao se entrada == "s" {
			jogo.MudarDirecao(DirBaixo)
		} senao se entrada == "a" {
			jogo.MudarDirecao(DirEsquerda)
		} senao se entrada == "d" {
			jogo.MudarDirecao(DirDireita)
		}

		jogo.AvancarTurno()
		formatar.ImprimirLinha("")
	}

	formatar.ImprimirLinha("\n==================================================")
	formatar.ImprimirLinha("                  FIM DE JOGO!                    ")
	formatar.ImprimirFormatado(" Pontuação Final: %d | Recorde: %d | Tamanho: %d\n", jogo.Pontuacao, jogo.Recorde, tamanho(jogo.Corpo))
	formatar.ImprimirLinha("==================================================")
}
