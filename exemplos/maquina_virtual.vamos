// Exemplo de execução direta na Máquina Virtual VVM (VAMOS Virtual Machine)
// Este código pode ser executado diretamente na VVM via:
//    vamosc vm exemplos/maquina_virtual.vamos
// Ou compilado para bytecode independente (.vamosb):
//    vamosc bytecode exemplos/maquina_virtual.vamos -o vm_app.vamosb
//    vamosc vm vm_app.vamosb

pacote principal

importar (
	"formatar"
)

tipo Usuario estrutura {
	Nome  texto
	Idade inteiro
}

funcao calcularPontuacao(base inteiro, bonus inteiro) inteiro {
	retornar base * 4 + bonus
}

funcao fatorial(n inteiro) inteiro {
	se n <= 1 {
		retornar 1
	}
	retornar n * fatorial(n - 1)
}

funcao principal() {
	formatar.ImprimirLinha("================================================")
	formatar.ImprimirLinha("   DEMONSTRAÇÃO DA MÁQUINA VIRTUAL VVM         ")
	formatar.ImprimirLinha("================================================")

	// 1. Chamada de Função e Aritmética
	resultado := calcularPontuacao(15, 10)
	formatar.ImprimirLinha("Cálculo via função na VVM (15 * 4 + 10):")
	formatar.ImprimirLinha(resultado)

	// 2. Condicionais Relacionais
	se resultado >= 70 {
		formatar.ImprimirLinha("Avaliação: resultado atingiu a meta (>= 70)!")
	} senao {
		formatar.ImprimirLinha("Avaliação: resultado abaixo da meta.")
	}

	// 3. Função Recursiva com Quadro de Pilha
	fat5 := fatorial(5)
	formatar.ImprimirLinha("Recursão na VVM - Fatorial de 5:")
	formatar.ImprimirLinha(fat5)

	// 4. Listas, Fatias e Indexação Dinâmica
	formatar.ImprimirLinha("Operações com listas na pilha VVM:")
	linguagens := []texto{"Go", "VAMOS-LANG"}
	linguagens = anexar(linguagens, "Bytecode VVM")
	formatar.ImprimirLinha("Total de itens na lista:")
	formatar.ImprimirLinha(tamanho(linguagens))
	formatar.ImprimirLinha("Item no índice 1:")
	formatar.ImprimirLinha(linguagens[1])

	// 5. Estrutura de Repetição com Índice
	formatar.ImprimirLinha("Percorrendo lista na VVM:")
	idx := 0
	para idx < tamanho(linguagens) {
		formatar.ImprimirLinha(linguagens[idx])
		idx = idx + 1
	}

	// 6. Mapas Dinâmicos Chave-Valor na VVM
	formatar.ImprimirLinha("Operações com mapas chave-valor na VVM:")
	capitais := mapa[texto]texto{"Brasil": "Brasília", "Portugal": "Lisboa"}
	formatar.ImprimirLinha("Capital do Brasil:")
	formatar.ImprimirLinha(capitais["Brasil"])
	capitais["Franca"] = "Paris"
	formatar.ImprimirLinha("Capital da França (adicionada dinamicamente):")
	formatar.ImprimirLinha(capitais["Franca"])

	// 7. Estruturas Customizadas e Acesso a Campos na VVM
	formatar.ImprimirLinha("Estruturas na VVM:")
	dev := Usuario{Nome: "Ana", Idade: 28}
	formatar.ImprimirLinha("Nome do usuário na struct:")
	formatar.ImprimirLinha(dev.Nome)
	dev.Idade = 29
	formatar.ImprimirLinha("Idade atualizada na struct:")
	formatar.ImprimirLinha(dev.Idade)

	formatar.ImprimirLinha("VVM: Execução de bytecode finalizada com sucesso!")
}
