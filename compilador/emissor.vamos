// Pacote compilador - Emissor de Bytecode VVM a partir da AST em VAMOS-LANG
// Percorre a árvore sintática abstrata e sintetiza o ProgramaBytecode executável.

pacote principal

importar (
	"cordas"
)

// EmissorBytecode transforma a AST em sequência linear de instruções VVM
tipo EmissorBytecode estrutura {
	programa *ProgramaBytecode
}

// NovoEmissorBytecode instancia um novo emissor
funcao NovoEmissorBytecode() *EmissorBytecode {
	retornar &EmissorBytecode{
		programa: NovoProgramaBytecode(),
	}
}

// limparTextoLiteral remove aspas envolventes de literais de texto
funcao limparTextoLiteral(s texto) texto {
	se tamanho(s) >= 2 && cordas.TemPrefixo(s, "\"") && cordas.TemSufixo(s, "\"") {
		retornar s[1 : tamanho(s)-1]
	}
	retornar s
}

// dividirForaParenteses divide uma expressão por um operador apenas no nível raiz (fora de parênteses e aspas)
funcao dividirForaParenteses(s texto, op texto) []texto {
	partes := criar([]texto, 0)
	tamOp := tamanho(op)
	nivel := 0
	emAspas := falso
	inicio := 0
	tamS := tamanho(s)

	para i := 0; i < tamS; i++ {
		resto := s[i:]
		se cordas.TemPrefixo(resto, "\"") {
			emAspas = !emAspas
		} senao se !emAspas {
			se cordas.TemPrefixo(resto, "(") || cordas.TemPrefixo(resto, "[") {
				nivel++
			} senao se cordas.TemPrefixo(resto, ")") || cordas.TemPrefixo(resto, "]") {
				se nivel > 0 {
					nivel--
				}
			} senao se nivel == 0 && i+tamOp <= tamS && cordas.TemPrefixo(resto, op) {
				partes = anexar(partes, s[inicio:i])
				inicio = i + tamOp
				i = i + tamOp - 1
			}
		}
	}

	partes = anexar(partes, s[inicio:])
	retornar partes
}

// CompilarAST processa o nó raiz da AST e produz o programa em bytecode
funcao (e *EmissorBytecode) CompilarAST(raiz *NoAST) *ProgramaBytecode {
	se raiz == nulo {
		retornar e.programa
	}

	// 1. Variáveis e constantes globais
	para _, filho := intervalo raiz.Filhos {
		se filho.Tipo == NoTipoVariavel || filho.Tipo == NoTipoConstante {
			e.visitarNo(filho)
		}
	}

	// 2. Salto incondicional para a função principal
	idxSaltoPrincipal := e.programa.Emitir(OpSalto, 0, raiz.Linha)

	// 3. Emissão de funções auxiliares (que não são 'principal')
	para _, filho := intervalo raiz.Filhos {
		se filho.Tipo == NoTipoFuncao && filho.Nome != "principal" {
			e.emitirFuncao(filho)
		}
	}

	// 4. Ajusta endereço de salto para a função principal
	enderecoPrincipal := tamanho(e.programa.Instrucoes)
	e.programa.ModificarArgumento(idxSaltoPrincipal, enderecoPrincipal)
	e.programa.Funcoes["principal"] = enderecoPrincipal

	// 5. Corpo da função principal
	achouPrincipal := falso
	para _, filho := intervalo raiz.Filhos {
		se filho.Tipo == NoTipoFuncao && filho.Nome == "principal" {
			achouPrincipal = verdadeiro
			para _, neto := intervalo filho.Filhos {
				se neto.Tipo == NoTipoBloco {
					e.visitarNo(neto)
				}
			}
		}
	}

	// Se não houver 'principal' explícita, processa nós soltos de nível superior
	se !achouPrincipal {
		para _, filho := intervalo raiz.Filhos {
			se filho.Tipo != NoTipoVariavel && filho.Tipo != NoTipoConstante && filho.Tipo != NoTipoFuncao {
				e.visitarNo(filho)
			}
		}
	}

	e.programa.Emitir(OpParar, 0, raiz.Linha)
	retornar e.programa
}

// emitirFuncao compila uma função nomeada com seus parâmetros e bloco
funcao (e *EmissorBytecode) emitirFuncao(no *NoAST) {
	e.programa.Funcoes[no.Nome] = tamanho(e.programa.Instrucoes)

	// Coleta parâmetros
	params := criar([]texto, 0)
	para _, filho := intervalo no.Filhos {
		se filho.Tipo == NoTipoParametro {
			params = anexar(params, filho.Nome)
		}
	}

	// Desempilha parâmetros em ordem reversa
	para i := tamanho(params) - 1; i >= 0; i-- {
		idxParam := e.programa.AdicionarIdentificador(params[i])
		e.programa.Emitir(OpDefinirLocal, idxParam, no.Linha)
	}

	// Visita os blocos internos da função
	para _, filho := intervalo no.Filhos {
		se filho.Tipo == NoTipoBloco {
			e.visitarNo(filho)
		}
	}

	// Retorno padrão vazio caso não haja instrução explícita
	idxVazio := e.programa.AdicionarConstante("")
	e.programa.Emitir(OpConstante, idxVazio, no.Linha)
	e.programa.Emitir(OpRetornar, 0, no.Linha)
}

// emitirRetorno processa a instrução de retorno da função
funcao (e *EmissorBytecode) emitirRetorno(no *NoAST) {
	val := cordas.ApararEspaco(no.Valor)
	se val != "" {
		e.emitirAvaliacaoExpressao(val, no.Linha)
	} senao {
		idxVazio := e.programa.AdicionarConstante("")
		e.programa.Emitir(OpConstante, idxVazio, no.Linha)
	}
	e.programa.Emitir(OpRetornar, 0, no.Linha)
}

// visitarNo percorre recursivamente nós da AST
funcao (e *EmissorBytecode) visitarNo(no *NoAST) {
	se no == nulo {
		retornar
	}

	escolha no.Tipo {
	caso NoTipoPrograma:
		para _, filho := intervalo no.Filhos {
			e.visitarNo(filho)
		}

	caso NoTipoFuncao:
		para _, filho := intervalo no.Filhos {
			se filho.Tipo == NoTipoBloco {
				e.visitarNo(filho)
			}
		}

	caso NoTipoBloco:
		para _, filho := intervalo no.Filhos {
			e.visitarNo(filho)
		}

	caso NoTipoVariavel, NoTipoConstante:
		e.emitirDeclaracaoVariavel(no)

	caso NoTipoCondicional:
		e.emitirCondicional(no)

	caso NoTipoLaco:
		e.emitirLaco(no)

	caso NoTipoExpressao:
		e.emitirExpressaoOuInstrucao(no)

	caso NoTipoRetorno:
		e.emitirRetorno(no)
	}
}

// emitirDeclaracaoVariavel processa variáveis globais ou locais
funcao (e *EmissorBytecode) emitirDeclaracaoVariavel(no *NoAST) {
	idxVar := e.programa.AdicionarIdentificador(no.Nome)
	valStr := cordas.ApararEspaco(no.Valor)

	// Extrai o valor inicial após '=' se houver
	se cordas.Contem(valStr, "=") {
		partes := cordas.Dividir(valStr, "=")
		se tamanho(partes) >= 2 {
			conteudo := cordas.ApararEspaco(partes[1])
			e.emitirAvaliacaoExpressao(conteudo, no.Linha)
			e.programa.Emitir(OpDefinirGlobal, idxVar, no.Linha)
			retornar
		}
	}

	// Valor padrão vazio se não inicializado
	idxConstZero := e.programa.AdicionarConstante("")
	e.programa.Emitir(OpConstante, idxConstZero, no.Linha)
	e.programa.Emitir(OpDefinirGlobal, idxVar, no.Linha)
}

// emitirCondicional compila estruturas 'se condicao { ... } senao { ... }'
funcao (e *EmissorBytecode) emitirCondicional(no *NoAST) {
	cond := cordas.ApararEspaco(no.Valor)
	e.emitirAvaliacaoExpressao(cond, no.Linha)

	// Emite salto se falso com endereço provisório 0
	idxSaltoSeFalso := e.programa.Emitir(OpSaltoSeFalso, 0, no.Linha)

	// Visita os blocos internos
	temSenao := falso
	var noSenao *NoAST = nulo

	para _, filho := intervalo no.Filhos {
		se filho.Tipo == NoTipoCondicional && filho.Nome == "Senao" {
			temSenao = verdadeiro
			noSenao = filho
		} senao {
			e.visitarNo(filho)
		}
	}

	se temSenao && noSenao != nulo {
		// Pula o bloco senao após executar o bloco se
		idxSaltoFim := e.programa.Emitir(OpSalto, 0, no.Linha)
		// O salto se falso vai para o início do senao
		e.programa.ModificarArgumento(idxSaltoSeFalso, tamanho(e.programa.Instrucoes))
		e.visitarNo(noSenao)
		// O salto do fim do se vai para depois do senao
		e.programa.ModificarArgumento(idxSaltoFim, tamanho(e.programa.Instrucoes))
	} senao {
		// Corrige endereço para após o bloco se
		e.programa.ModificarArgumento(idxSaltoSeFalso, tamanho(e.programa.Instrucoes))
	}
}

// emitirLaco compila laços 'para'
funcao (e *EmissorBytecode) emitirLaco(no *NoAST) {
	enderecoInicio := tamanho(e.programa.Instrucoes)
	cond := cordas.ApararEspaco(no.Valor)

	se cond != "" {
		e.emitirAvaliacaoExpressao(cond, no.Linha)
	} senao {
		idxConstVerdade := e.programa.AdicionarConstante("verdadeiro")
		e.programa.Emitir(OpConstante, idxConstVerdade, no.Linha)
	}

	idxSaltoSaida := e.programa.Emitir(OpSaltoSeFalso, 0, no.Linha)

	para _, filho := intervalo no.Filhos {
		e.visitarNo(filho)
	}

	// Volta ao início do laço
	e.programa.Emitir(OpSalto, enderecoInicio, no.Linha)
	// Ajusta salto de saída do laço
	e.programa.ModificarArgumento(idxSaltoSaida, tamanho(e.programa.Instrucoes))
}

// emitirExpressaoOuInstrucao trata linhas com atribuição ou chamadas da stdlib
funcao (e *EmissorBytecode) emitirExpressaoOuInstrucao(no *NoAST) {
	expr := cordas.ApararEspaco(no.Valor)

	// 1. Chamada de ImprimirLinha / fmt.Println
	se cordas.Contem(expr, "ImprimirLinha") || cordas.Contem(expr, "Println") {
		idxAbre := cordas.Indice(expr, "(")
		idxFecha := cordas.UltimoIndice(expr, ")")
		se idxAbre != -1 && idxFecha != -1 && idxFecha > idxAbre {
			conteudoParam := cordas.ApararEspaco(expr[idxAbre+1 : idxFecha])
			e.emitirAvaliacaoExpressao(conteudoParam, no.Linha)
			e.programa.Emitir(OpImprimirLinha, 0, no.Linha)
			retornar
		}
	} senao se cordas.Contem(expr, "Imprimir") || cordas.Contem(expr, "Print") {
		idxAbre := cordas.Indice(expr, "(")
		idxFecha := cordas.UltimoIndice(expr, ")")
		se idxAbre != -1 && idxFecha != -1 && idxFecha > idxAbre {
			conteudoParam := cordas.ApararEspaco(expr[idxAbre+1 : idxFecha])
			e.emitirAvaliacaoExpressao(conteudoParam, no.Linha)
			e.programa.Emitir(OpImprimir, 0, no.Linha)
			retornar
		}
	}

	// 2. Atribuição de índice (lista[i] = ...) ou variável (x := ... / x = ...)
	se cordas.Contem(expr, ":=") || cordas.Contem(expr, "=") {
		sep := ":="
		se !cordas.Contem(expr, ":=") {
			sep = "="
		}
		partes := cordas.Dividir(expr, sep)
		se tamanho(partes) >= 2 {
			ladoEsq := cordas.ApararEspaco(partes[0])
			conteudoValor := cordas.ApararEspaco(partes[1])

			// Atribuição a elemento de lista: lista[i] = ...
			se cordas.Contem(ladoEsq, "[") && cordas.TemSufixo(ladoEsq, "]") {
				idxAbreCol := cordas.Indice(ladoEsq, "[")
				nomeLista := cordas.ApararEspaco(ladoEsq[:idxAbreCol])
				exprIdx := cordas.ApararEspaco(ladoEsq[idxAbreCol+1 : tamanho(ladoEsq)-1])
				e.emitirAvaliacaoExpressao(nomeLista, no.Linha)
				e.emitirAvaliacaoExpressao(exprIdx, no.Linha)
				e.emitirAvaliacaoExpressao(conteudoValor, no.Linha)
				idxVar := e.programa.AdicionarIdentificador(nomeLista)
				e.programa.Emitir(OpDefinirIndice, idxVar, no.Linha)
				e.programa.Emitir(OpDescartar, 0, no.Linha)
				retornar
			}

			// Atribuição a campo de estrutura: obj.campo = ...
			se cordas.Contem(ladoEsq, ".") && !cordas.Contem(ladoEsq, "(") {
				idxPonto := cordas.Indice(ladoEsq, ".")
				nomeObj := cordas.ApararEspaco(ladoEsq[:idxPonto])
				nomeCampo := cordas.ApararEspaco(ladoEsq[idxPonto+1:])
				e.emitirAvaliacaoExpressao(nomeObj, no.Linha)
				idxConstCampo := e.programa.AdicionarConstante(nomeCampo)
				e.programa.Emitir(OpConstante, idxConstCampo, no.Linha)
				e.emitirAvaliacaoExpressao(conteudoValor, no.Linha)
				idxVar := e.programa.AdicionarIdentificador(nomeObj)
				e.programa.Emitir(OpDefinirIndice, idxVar, no.Linha)
				e.programa.Emitir(OpDescartar, 0, no.Linha)
				retornar
			}

			e.emitirAvaliacaoExpressao(conteudoValor, no.Linha)
			idxVar := e.programa.AdicionarIdentificador(ladoEsq)
			e.programa.Emitir(OpDefinirGlobal, idxVar, no.Linha)
			retornar
		}
	}

	// 3. Chamada avulsa de função: fn(...)
	idxAbreFn := cordas.Indice(expr, "(")
	idxFechaFn := cordas.UltimoIndice(expr, ")")
	se idxAbreFn > 0 && idxFechaFn == tamanho(expr)-1 && !cordas.Contem(expr, ":=") && !cordas.Contem(expr, "=") {
		nomeFn := cordas.ApararEspaco(expr[:idxAbreFn])
		se !cordas.Contem(nomeFn, " ") {
			e.emitirAvaliacaoExpressao(expr, no.Linha)
			e.programa.Emitir(OpDescartar, 0, no.Linha)
			retornar
		}
	}
}

// emitirAvaliacaoExpressao decompõe expressões aritméticas ou literais e gera instruções na pilha
funcao (e *EmissorBytecode) emitirAvaliacaoExpressao(expr texto, linha inteiro) {
	limpa := cordas.ApararEspaco(expr)

	// Literais de texto puros entre aspas
	se cordas.TemPrefixo(limpa, "\"") && cordas.TemSufixo(limpa, "\"") && cordas.Contar(limpa, "\"") == 2 {
		idx := e.programa.AdicionarConstante(limparTextoLiteral(limpa))
		e.programa.Emitir(OpConstante, idx, linha)
		retornar
	}

	// Remoção de parênteses externos envolventes: (expr)
	se cordas.TemPrefixo(limpa, "(") && cordas.TemSufixo(limpa, ")") {
		nivel := 0
		fechaNoFim := verdadeiro
		para i := 0; i < tamanho(limpa)-1; i++ {
			resto := limpa[i:]
			se cordas.TemPrefixo(resto, "(") {
				nivel++
			} senao se cordas.TemPrefixo(resto, ")") {
				nivel--
				se nivel == 0 {
					fechaNoFim = falso
					interromper
				}
			}
		}
		se fechaNoFim {
			e.emitirAvaliacaoExpressao(cordas.ApararEspaco(limpa[1:tamanho(limpa)-1]), linha)
			retornar
		}
	}

	// Comparações relacionais fora de parênteses
	partesRel := dividirForaParenteses(limpa, ">=")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpMaiorIgual, 0, linha)
		retornar
	}
	partesRel = dividirForaParenteses(limpa, "<=")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpMenorIgual, 0, linha)
		retornar
	}
	partesRel = dividirForaParenteses(limpa, "==")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpIgual, 0, linha)
		retornar
	}
	partesRel = dividirForaParenteses(limpa, "!=")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpDiferente, 0, linha)
		retornar
	}
	partesRel = dividirForaParenteses(limpa, ">")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpMaior, 0, linha)
		retornar
	}
	partesRel = dividirForaParenteses(limpa, "<")
	se tamanho(partesRel) >= 2 {
		e.emitirAvaliacaoExpressao(partesRel[0], linha)
		e.emitirAvaliacaoExpressao(partesRel[1], linha)
		e.programa.Emitir(OpMenor, 0, linha)
		retornar
	}

	// Operações aritméticas fora de parênteses
	partesSoma := dividirForaParenteses(limpa, "+")
	se tamanho(partesSoma) >= 2 {
		e.emitirAvaliacaoExpressao(partesSoma[0], linha)
		para i := 1; i < tamanho(partesSoma); i++ {
			e.emitirAvaliacaoExpressao(partesSoma[i], linha)
			e.programa.Emitir(OpSomar, 0, linha)
		}
		retornar
	}
	partesSub := dividirForaParenteses(limpa, "-")
	se tamanho(partesSub) >= 2 {
		e.emitirAvaliacaoExpressao(partesSub[0], linha)
		para i := 1; i < tamanho(partesSub); i++ {
			e.emitirAvaliacaoExpressao(partesSub[i], linha)
			e.programa.Emitir(OpSubtrair, 0, linha)
		}
		retornar
	}
	partesMul := dividirForaParenteses(limpa, "*")
	se tamanho(partesMul) >= 2 {
		e.emitirAvaliacaoExpressao(partesMul[0], linha)
		para i := 1; i < tamanho(partesMul); i++ {
			e.emitirAvaliacaoExpressao(partesMul[i], linha)
			e.programa.Emitir(OpMultiplicar, 0, linha)
		}
		retornar
	}
	partesDiv := dividirForaParenteses(limpa, "/")
	se tamanho(partesDiv) >= 2 {
		e.emitirAvaliacaoExpressao(partesDiv[0], linha)
		para i := 1; i < tamanho(partesDiv); i++ {
			e.emitirAvaliacaoExpressao(partesDiv[i], linha)
			e.programa.Emitir(OpDividir, 0, linha)
		}
		retornar
	}

	// Chamada de função: func(arg1, arg2)
	idxAbre := cordas.Indice(limpa, "(")
	idxFecha := cordas.UltimoIndice(limpa, ")")
	se idxAbre > 0 && idxFecha == tamanho(limpa)-1 {
		nomeFn := cordas.ApararEspaco(limpa[:idxAbre])
		se !cordas.Contem(nomeFn, " ") && !cordas.Contem(nomeFn, "+") && !cordas.Contem(nomeFn, "-") &&
			!cordas.Contem(nomeFn, "*") && !cordas.Contem(nomeFn, "/") && !cordas.Contem(nomeFn, "\"") {

			conteudoArgs := cordas.ApararEspaco(limpa[idxAbre+1 : idxFecha])

			// Tratamento especial para helpers internos
			se nomeFn == "conversao.InteiroParaTexto" || nomeFn == "conversao.ParaInteiro" ||
				nomeFn == "strconv.Itoa" || nomeFn == "strconv.Atoi" {
				e.emitirAvaliacaoExpressao(conteudoArgs, linha)
				retornar
			}

			se nomeFn == "tamanho" || nomeFn == "len" {
				e.emitirAvaliacaoExpressao(conteudoArgs, linha)
				e.programa.Emitir(OpTamanho, 0, linha)
				retornar
			}

			// Helpers de lista / fatias
			se nomeFn == "anexar" || nomeFn == "append" {
				se conteudoArgs != "" {
					args := dividirForaParenteses(conteudoArgs, ",")
					se tamanho(args) >= 2 {
						e.emitirAvaliacaoExpressao(cordas.ApararEspaco(args[0]), linha)
						e.emitirAvaliacaoExpressao(cordas.ApararEspaco(args[1]), linha)
						e.programa.Emitir(OpAnexar, 0, linha)
						retornar
					}
				}
			}

			se nomeFn == "criar" || nomeFn == "make" {
				e.programa.Emitir(OpCriarLista, 0, linha)
				retornar
			}

			se conteudoArgs != "" {
				args := dividirForaParenteses(conteudoArgs, ",")
				para _, arg := intervalo args {
					e.emitirAvaliacaoExpressao(cordas.ApararEspaco(arg), linha)
				}
			}

			idxId := e.programa.AdicionarIdentificador(nomeFn)
			e.programa.Emitir(OpChamar, idxId, linha)
			retornar
		}
	}

	// Literal de Lista/Fatia: [item0, ...] ou [ ] tipo { item0, ... }
	se (cordas.TemPrefixo(limpa, "[") && cordas.TemSufixo(limpa, "]") && !cordas.Contem(limpa, "{")) ||
		(cordas.Contem(limpa, "{") && cordas.TemSufixo(limpa, "}")) {

		conteudoLista := ""
		se cordas.Contem(limpa, "{") && cordas.TemSufixo(limpa, "}") {
			idxChave := cordas.Indice(limpa, "{")
			conteudoLista = cordas.ApararEspaco(limpa[idxChave+1 : tamanho(limpa)-1])
		} senao {
			conteudoLista = cordas.ApararEspaco(limpa[1 : tamanho(limpa)-1])
		}

		se conteudoLista == "" {
			e.programa.Emitir(OpCriarLista, 0, linha)
			retornar
		}

		se cordas.Contem(conteudoLista, ":") {
			itens := dividirForaParenteses(conteudoLista, ",")
			para _, it := intervalo itens {
				itLimpo := cordas.ApararEspaco(it)
				idxDoisPontos := cordas.Indice(itLimpo, ":")
				se idxDoisPontos > 0 {
					k := cordas.ApararEspaco(itLimpo[:idxDoisPontos])
					v := cordas.ApararEspaco(itLimpo[idxDoisPontos+1:])
					k = cordas.Substituir(k, "\"", "", -1)
					idxK := e.programa.AdicionarConstante(k)
					e.programa.Emitir(OpConstante, idxK, linha)
					e.emitirAvaliacaoExpressao(v, linha)
				}
			}
			e.programa.Emitir(OpCriarMapa, tamanho(itens), linha)
			retornar
		}

		itens := dividirForaParenteses(conteudoLista, ",")
		para _, it := intervalo itens {
			e.emitirAvaliacaoExpressao(cordas.ApararEspaco(it), linha)
		}
		e.programa.Emitir(OpCriarLista, tamanho(itens), linha)
		retornar
	}

	// Acesso indexado: lista[i]
	idxColAbre := cordas.Indice(limpa, "[")
	se idxColAbre > 0 && cordas.TemSufixo(limpa, "]") {
		nomeAlvo := cordas.ApararEspaco(limpa[:idxColAbre])
		idxExpr := cordas.ApararEspaco(limpa[idxColAbre+1 : tamanho(limpa)-1])
		se !cordas.Contem(nomeAlvo, " ") && !cordas.Contem(nomeAlvo, "+") && !cordas.Contem(nomeAlvo, "-") {
			e.emitirAvaliacaoExpressao(nomeAlvo, linha)
			e.emitirAvaliacaoExpressao(idxExpr, linha)
			e.programa.Emitir(OpObterIndice, 0, linha)
			retornar
		}
	}

	// Acesso a campo de estrutura: obj.campo
	idxPonto := cordas.Indice(limpa, ".")
	se idxPonto > 0 && !cordas.Contem(limpa, "(") && !cordas.TemPrefixo(limpa, "\"") && !cordas.TemPrefixo(limpa, "formatar.") {
		nomeObj := cordas.ApararEspaco(limpa[:idxPonto])
		nomeCampo := cordas.ApararEspaco(limpa[idxPonto+1:])
		se !cordas.Contem(nomeObj, " ") && !cordas.Contem(nomeCampo, " ") {
			e.emitirAvaliacaoExpressao(nomeObj, linha)
			idxConstCampo := e.programa.AdicionarConstante(nomeCampo)
			e.programa.Emitir(OpConstante, idxConstCampo, linha)
			e.programa.Emitir(OpObterIndice, 0, linha)
			retornar
		}
	}

	// Se for texto literal com aspas
	se cordas.TemPrefixo(limpa, "\"") && cordas.TemSufixo(limpa, "\"") {
		idx := e.programa.AdicionarConstante(limparTextoLiteral(limpa))
		e.programa.Emitir(OpConstante, idx, linha)
		retornar
	}

	// Se for número puro ou identificador
	idxConst := e.programa.AdicionarConstante(limpa)
	para _, id := intervalo e.programa.Identificadores {
		se id == limpa {
			idxId := e.programa.AdicionarIdentificador(limpa)
			e.programa.Emitir(OpObterGlobal, idxId, linha)
			retornar
		}
	}

	e.programa.Emitir(OpConstante, idxConst, linha)
}
