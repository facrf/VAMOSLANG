// Pacote compilador - Máquina Virtual VVM (VAMOS Virtual Machine) em VAMOS-LANG
// Executa o bytecode VVM diretamente sem dependência de compilação intermediária ou toolchain Go.

pacote principal

importar (
	"conversao"
	"cordas"
	"erros"
	"formatar"
)

// QuadroChamada armazena o escopo de variáveis e retorno de uma função ativa
tipo QuadroChamada estrutura {
	ipRetorno  inteiro
	locais     mapa[texto]texto
	nomeFuncao texto
}

// MaquinaVirtual executa as instruções de bytecode na pilha
tipo MaquinaVirtual estrutura {
	pilha    []texto
	topo     inteiro
	globais  mapa[texto]texto
	quadros  []QuadroChamada
	ip       inteiro
}

// NovaMaquinaVirtual cria uma nova instância de execução da VM
funcao NovaMaquinaVirtual() *MaquinaVirtual {
	vm := &MaquinaVirtual{
		pilha:   criar([]texto, 2048),
		topo:    0,
		globais: criar(mapa[texto]texto),
		quadros: criar([]QuadroChamada, 0),
		ip:      0,
	}
	base := QuadroChamada{
		ipRetorno:  -1,
		locais:     criar(mapa[texto]texto),
		nomeFuncao: "principal",
	}
	vm.quadros = anexar(vm.quadros, base)
	retornar vm
}

// empilhar insere um valor no topo da pilha de execução
funcao (vm *MaquinaVirtual) empilhar(valor texto) {
	se vm.topo < tamanho(vm.pilha) {
		vm.pilha[vm.topo] = valor
		vm.topo++
	}
}

// desempilhar retira e retorna o valor do topo da pilha
funcao (vm *MaquinaVirtual) desempilhar() texto {
	se vm.topo <= 0 {
		retornar ""
	}
	vm.topo--
	retornar vm.pilha[vm.topo]
}

// espiarTopo consulta o valor do topo da pilha sem desempilhar
funcao (vm *MaquinaVirtual) espiarTopo() texto {
	se vm.topo <= 0 {
		retornar ""
	}
	retornar vm.pilha[vm.topo-1]
}

// ehVerdadeiro verifica se o valor avalia para verdadeiro na lógica da VM
funcao ehVerdadeiro(v texto) booleano {
	retornar v != "falso" && v != "0" && v != "" && v != "nulo"
}

// extrairItensLista decodifica a representação de lista em texto para elementos individuais
funcao extrairItensLista(lista texto) []texto {
	itens := criar([]texto, 0)
	se !cordas.TemPrefixo(lista, "[") || !cordas.TemSufixo(lista, "]") {
		retornar itens
	}
	conteudo := cordas.ApararEspaco(lista[1 : tamanho(lista)-1])
	se conteudo == "" {
		retornar itens
	}

	tam := tamanho(conteudo)
	inicio := 0
	nivel := 0
	emAspas := falso

	para i := 0; i < tam; i++ {
		resto := conteudo[i:]
		se cordas.TemPrefixo(resto, "\"") {
			emAspas = !emAspas
		} senao se !emAspas {
			se cordas.TemPrefixo(resto, "[") || cordas.TemPrefixo(resto, "(") {
				nivel++
			} senao se cordas.TemPrefixo(resto, "]") || cordas.TemPrefixo(resto, ")") {
				se nivel > 0 {
					nivel--
				}
			} senao se nivel == 0 && cordas.TemPrefixo(resto, ",") {
				item := cordas.ApararEspaco(conteudo[inicio:i])
				se cordas.TemPrefixo(item, "\"") && cordas.TemSufixo(item, "\"") && tamanho(item) >= 2 {
					item = item[1 : tamanho(item)-1]
				}
				itens = anexar(itens, item)
				inicio = i + 1
			}
		}
	}

	itemFinal := cordas.ApararEspaco(conteudo[inicio:])
	se cordas.TemPrefixo(itemFinal, "\"") && cordas.TemSufixo(itemFinal, "\"") && tamanho(itemFinal) >= 2 {
		itemFinal = itemFinal[1 : tamanho(itemFinal)-1]
	}
	itens = anexar(itens, itemFinal)
	retornar itens
}

// formatarLista codifica elementos de uma fatia/vetor em texto representativo
funcao formatarLista(itens []texto) texto {
	elementos := criar([]texto, 0)
	para _, it := intervalo itens {
		elementos = anexar(elementos, formatar.Formatar("\"%s\"", it))
	}
	retornar "[" + cordas.Juntar(elementos, ", ") + "]"
}

// Interpretar executa as instruções de um ProgramaBytecode do início ao fim
funcao (vm *MaquinaVirtual) Interpretar(prog *ProgramaBytecode) erro {
	vm.ip = 0
	vm.topo = 0
	vm.quadros = criar([]QuadroChamada, 0)
	base := QuadroChamada{
		ipRetorno:  -1,
		locais:     criar(mapa[texto]texto),
		nomeFuncao: "principal",
	}
	vm.quadros = anexar(vm.quadros, base)

	totalInstrucoes := tamanho(prog.Instrucoes)

	para vm.ip < totalInstrucoes {
		inst := prog.Instrucoes[vm.ip]
		vm.ip++

		escolha inst.Opcode {
		caso OpConstante:
			val := ""
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Constantes) {
				val = prog.Constantes[inst.Argumento]
			}
			vm.empilhar(val)

		caso OpDefinirGlobal:
			val := vm.desempilhar()
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nome := prog.Identificadores[inst.Argumento]
				se tamanho(vm.quadros) > 1 {
					vm.quadros[tamanho(vm.quadros)-1].locais[nome] = val
				} senao {
					vm.globais[nome] = val
				}
			}

		caso OpObterGlobal:
			val := ""
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nome := prog.Identificadores[inst.Argumento]
				achou := falso
				se tamanho(vm.quadros) > 0 {
					quadro := vm.quadros[tamanho(vm.quadros)-1]
					se v, ok := quadro.locais[nome]; ok {
						val = v
						achou = verdadeiro
					}
				}
				se !achou {
					se v, ok := vm.globais[nome]; ok {
						val = v
					}
				}
			}
			vm.empilhar(val)

		caso OpDefinirLocal:
			val := vm.desempilhar()
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nome := prog.Identificadores[inst.Argumento]
				se tamanho(vm.quadros) > 0 {
					vm.quadros[tamanho(vm.quadros)-1].locais[nome] = val
				} senao {
					vm.globais[nome] = val
				}
			}

		caso OpObterLocal:
			val := ""
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nome := prog.Identificadores[inst.Argumento]
				achou := falso
				se tamanho(vm.quadros) > 0 {
					quadro := vm.quadros[tamanho(vm.quadros)-1]
					se v, ok := quadro.locais[nome]; ok {
						val = v
						achou = verdadeiro
					}
				}
				se !achou {
					se v, ok := vm.globais[nome]; ok {
						val = v
					}
				}
			}
			vm.empilhar(val)

		caso OpSomar:
			b := vm.desempilhar()
			a := vm.desempilhar()
			// Tenta somar como inteiros
			intA, errA := conversao.ParaInteiro(a)
			intB, errB := conversao.ParaInteiro(b)
			se errA == nulo && errB == nulo {
				vm.empilhar(conversao.InteiroParaTexto(intA + intB))
			} senao {
				// Concatenação de texto
				vm.empilhar(a + b)
			}

		caso OpSubtrair:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			vm.empilhar(conversao.InteiroParaTexto(intA - intB))

		caso OpMultiplicar:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			vm.empilhar(conversao.InteiroParaTexto(intA * intB))

		caso OpDividir:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			se intB == 0 {
				retornar erros.Novo("erro na VM: divisão por zero")
			}
			vm.empilhar(conversao.InteiroParaTexto(intA / intB))

		caso OpIgual:
			b := vm.desempilhar()
			a := vm.desempilhar()
			se a == b {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpDiferente:
			b := vm.desempilhar()
			a := vm.desempilhar()
			se a != b {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpMaior:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			se intA > intB {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpMenor:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			se intA < intB {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpMaiorIgual:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			se intA >= intB {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpMenorIgual:
			b := vm.desempilhar()
			a := vm.desempilhar()
			intA, _ := conversao.ParaInteiro(a)
			intB, _ := conversao.ParaInteiro(b)
			se intA <= intB {
				vm.empilhar("verdadeiro")
			} senao {
				vm.empilhar("falso")
			}

		caso OpSalto:
			vm.ip = inst.Argumento

		caso OpSaltoSeFalso:
			cond := vm.desempilhar()
			se !ehVerdadeiro(cond) {
				vm.ip = inst.Argumento
			}

		caso OpImprimirLinha:
			val := vm.desempilhar()
			formatar.ImprimirLinha(val)

		caso OpImprimir:
			val := vm.desempilhar()
			formatar.Imprimir(val)

		caso OpDescartar:
			vm.desempilhar()

		caso OpChamar:
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nomeFunc := prog.Identificadores[inst.Argumento]
				enderecoDestino, ok := prog.Funcoes[nomeFunc]
				se !ok {
					retornar erros.Novo(formatar.Formatar("função '%s' não encontrada na linha %d", nomeFunc, inst.Linha))
				}
				novoQuadro := QuadroChamada{
					ipRetorno:  vm.ip,
					locais:     criar(mapa[texto]texto),
					nomeFuncao: nomeFunc,
				}
				vm.quadros = anexar(vm.quadros, novoQuadro)
				vm.ip = enderecoDestino
			}

		caso OpRetornar:
			valRetorno := vm.desempilhar()
			se tamanho(vm.quadros) <= 1 {
				vm.empilhar(valRetorno)
				interromper
			}
			ultimoQuadro := vm.quadros[tamanho(vm.quadros)-1]
			vm.quadros = vm.quadros[:tamanho(vm.quadros)-1]
			vm.ip = ultimoQuadro.ipRetorno
			vm.empilhar(valRetorno)

		caso OpTamanho:
			val := vm.desempilhar()
			se cordas.TemPrefixo(val, "[") && cordas.TemSufixo(val, "]") {
				itens := extrairItensLista(val)
				vm.empilhar(conversao.InteiroParaTexto(tamanho(itens)))
			} senao {
				vm.empilhar(conversao.InteiroParaTexto(tamanho(val)))
			}

		caso OpCriarLista:
			n := inst.Argumento
			itens := criar([]texto, n)
			para i := n - 1; i >= 0; i-- {
				itens[i] = vm.desempilhar()
			}
			vm.empilhar(formatarLista(itens))

		caso OpAnexar:
			item := vm.desempilhar()
			lista := vm.desempilhar()
			itens := extrairItensLista(lista)
			itens = anexar(itens, item)
			vm.empilhar(formatarLista(itens))

		caso OpObterIndice:
			idxStr := vm.desempilhar()
			lista := vm.desempilhar()
			idx, _ := conversao.ParaInteiro(idxStr)
			itens := extrairItensLista(lista)
			val := ""
			se idx >= 0 && idx < tamanho(itens) {
				val = itens[idx]
			}
			vm.empilhar(val)

		caso OpDefinirIndice:
			novoVal := vm.desempilhar()
			idxStr := vm.desempilhar()
			lista := vm.desempilhar()
			idx, _ := conversao.ParaInteiro(idxStr)
			itens := extrairItensLista(lista)
			se idx >= 0 && idx < tamanho(itens) {
				itens[idx] = novoVal
			}
			listaAtualizada := formatarLista(itens)
			se inst.Argumento >= 0 && inst.Argumento < tamanho(prog.Identificadores) {
				nomeVar := prog.Identificadores[inst.Argumento]
				se tamanho(vm.quadros) > 1 {
					vm.quadros[tamanho(vm.quadros)-1].locais[nomeVar] = listaAtualizada
				} senao {
					vm.globais[nomeVar] = listaAtualizada
				}
			}
			vm.empilhar(listaAtualizada)

		caso OpParar:
			interromper

		padrao:
			retornar erros.Novo(formatar.Formatar("instrução desconhecida %d na linha %d", inst.Opcode, inst.Linha))
		}
	}

	retornar nulo
}
