)

constante VersaoCompilador texto = "4.0.0-bootstrap"

funcao exibirAjuda() {
	formatar.ImprimirLinha("==================================================================")
	formatar.ImprimirLinha("   COMPILADOR AUTO-HOSPEDADO VAMOS-LANG (vamosc) - ETAPAS 1 A 10 ")
	formatar.ImprimirLinha("==================================================================")
	formatar.ImprimirLinha("Uso: vamosc <comando> [arquivo.vamos] [opcoes...]")
	formatar.ImprimirLinha("")
	formatar.ImprimirLinha("Comandos disponíveis:")
	formatar.ImprimirLinha("  compilar, build <arquivo.vamos> [-o saida]  Compila para executável binário")
	formatar.ImprimirLinha("  compilar-c <arquivo.vamos> [-o binario]     Compila para binário nativo via GCC")
	formatar.ImprimirLinha("  rodar, run <arquivo.vamos> [args...]        Executa código VAMOS diretamente")
	formatar.ImprimirLinha("  vm, executar-vm <arquivo.vamos|.vamosb>     Executa na Máquina Virtual VVM")
	formatar.ImprimirLinha("  bytecode <arquivo.vamos> [-o saida.vamosb]  Gera/desassembla Bytecode VVM")
	formatar.ImprimirLinha("  otimizar <arquivo.vamos|.vamosb> [-o saida] Otimiza bytecode com Constant Folding")
	formatar.ImprimirLinha("  wasm <arquivo.vamos> [-o saida.wasm]        Gera binário WebAssembly (.wasm)")
	formatar.ImprimirLinha("  c <arquivo.vamos> [-o saida.c]              Gera código-fonte C99 nativo")
	formatar.ImprimirLinha("  checar, semantico <arquivo.vamos>           Verificação semântica estática e tipos")
	formatar.ImprimirLinha("  formatar, fmt <arquivo.vamos>               Formata código padronizado")
	formatar.ImprimirLinha("  ast, --ast <arquivo.vamos>                  Exibe a Árvore Sintática (AST)")
	formatar.ImprimirLinha("  tokens, --tokens <arquivo.vamos>            Lista tokens léxicos identificados")
	formatar.ImprimirLinha("  transpilar, --transpilar <arquivo> [-o f]   Transpila código para Go nativo")
	formatar.ImprimirLinha("  auto-teste, --auto-teste                    Executa suíte de integridade")
	formatar.ImprimirLinha("  versao, -v, --versao                        Exibe a versão do vamosc")
	formatar.ImprimirLinha("  ajuda, -h, --ajuda                          Exibe esta tela de instruções")
	formatar.ImprimirLinha("==================================================================")
}

funcao inspecionarTokens(caminhoArquivo texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	conteudo := texto(dados)
	lexer := NovoAnalisadorLexico(conteudo)
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	formatar.ImprimirLinha("------------------------------------------------------------------")
	formatar.ImprimirFormatado("   INSPEÇÃO LÉXICA DO COMPILADOR VAMOS: %s\n", caminhoArquivo)
	formatar.ImprimirLinha("------------------------------------------------------------------")
	formatar.ImprimirLinha(" LINHA | COLUNA | TIPO             | VALOR LÉXICO")
	formatar.ImprimirLinha("-------+--------+------------------+------------------------------")

	para _, tok := intervalo tokens {
		se tok.Tipo == TokenEspaco || tok.Tipo == TokenQuebraLinha {
			continuar
		}
		valExibicao := tok.Valor
		se tok.Tipo == TokenFimArquivo {
			valExibicao = "<EOF>"
		}
		se tamanho(valExibicao) > 30 {
			valExibicao = valExibicao[:27] + "..."
		}
		nomeTipo := ObterNomeToken(tok.Tipo)
		formatar.ImprimirFormatado(
			" %5d | %6d | %-16s | %s\n",
			tok.Linha,
			tok.Coluna,
			nomeTipo,
			valExibicao,
		)
	}

	formatar.ImprimirLinha("------------------------------------------------------------------")
	formatar.ImprimirFormatado("Total de tokens identificados: %d\n", tamanho(tokens))
	formatar.ImprimirLinha("------------------------------------------------------------------")
}

funcao inspecionarAST(caminhoArquivo texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo {
		formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
		so.Sair(1)
	}

	formatar.ImprimirLinha("==================================================================")
	formatar.ImprimirFormatado("   ÁRVORE SINTÁTICA ABSTRATA (AST) - PARSER VAMOS: %s\n", caminhoArquivo)
	formatar.ImprimirLinha("==================================================================")
	ImprimirArvore(ast, "", verdadeiro)
	formatar.ImprimirLinha("==================================================================")
}

funcao executarBytecode(caminhoArquivo texto, destinoSaida texto) {
	var progBytecode *ProgramaBytecode
	se cordas.TemSufixo(caminhoArquivo, ".vamosb") {
		carregado, err := CarregarBytecodeDeArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao carregar bytecode '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}
		progBytecode = carregado
	} senao {
		dados, err := so.LerArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}

		lexer := NovoAnalisadorLexico(texto(dados))
		tokens, errLex := lexer.TokenizarTodos()
		se errLex != nulo {
			formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
			so.Sair(1)
		}

		parser := NovoAnalisadorSintatico(tokens)
		ast, errParse := parser.AnalisarPrograma()
		se errParse != nulo {
			formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
			so.Sair(1)
		}

		emissor := NovoEmissorBytecode()
		progBytecode = emissor.CompilarAST(ast)
	}

	se destinoSaida != "" {
		errSalvar := progBytecode.SalvarArquivo(destinoSaida)
		se errSalvar != nulo {
			formatar.ImprimirFormatado("Erro ao salvar arquivo de bytecode '%s': %v\n", destinoSaida, errSalvar)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("Bytecode VVM gravado com sucesso em '%s'\n", destinoSaida)
	} senao {
		formatar.ImprimirLinha(progBytecode.Desassemblar())
	}
}

funcao executarOtimizacao(caminhoArquivo texto, destinoSaida texto) {
	var progBytecode *ProgramaBytecode
	se cordas.TemSufixo(caminhoArquivo, ".vamosb") {
		carregado, err := CarregarBytecodeDeArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao carregar bytecode '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}
		progBytecode = carregado
	} senao {
		dados, err := so.LerArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}

		lexer := NovoAnalisadorLexico(texto(dados))
		tokens, errLex := lexer.TokenizarTodos()
		se errLex != nulo {
			formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
			so.Sair(1)
		}

		parser := NovoAnalisadorSintatico(tokens)
		ast, errParse := parser.AnalisarPrograma()
		se errParse != nulo {
			formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
			so.Sair(1)
		}

		emissor := NovoEmissorBytecode()
		progBytecode = emissor.CompilarAST(ast)
	}

	stats := OtimizarBytecode(progBytecode)
	formatar.ImprimirLinha(stats.Relatorio())

	se destinoSaida != "" {
		errSalvar := progBytecode.SalvarArquivo(destinoSaida)
		se errSalvar != nulo {
			formatar.ImprimirFormatado("Erro ao salvar arquivo de bytecode otimizado '%s': %v\n", destinoSaida, errSalvar)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("Bytecode VVM otimizado gravado com sucesso em '%s'\n", destinoSaida)
	} senao {
		formatar.ImprimirLinha("\n=== BYTECODE VVM OTIMIZADO ===")
		formatar.ImprimirLinha(progBytecode.Desassemblar())
	}
}

funcao executarVM(caminhoArquivo texto) {
	var progBytecode *ProgramaBytecode
	se cordas.TemSufixo(caminhoArquivo, ".vamosb") {
		carregado, err := CarregarBytecodeDeArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao carregar bytecode '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}
		progBytecode = carregado
	} senao {
		dados, err := so.LerArquivo(caminhoArquivo)
		se err != nulo {
			formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
			so.Sair(1)
		}

		lexer := NovoAnalisadorLexico(texto(dados))
		tokens, errLex := lexer.TokenizarTodos()
		se errLex != nulo {
			formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
			so.Sair(1)
		}

		parser := NovoAnalisadorSintatico(tokens)
		ast, errParse := parser.AnalisarPrograma()
		se errParse != nulo {
			formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
			so.Sair(1)
		}

		emissor := NovoEmissorBytecode()
		progBytecode = emissor.CompilarAST(ast)
	}

	vm := NovaMaquinaVirtual()
	errVM := vm.Interpretar(progBytecode)
	se errVM != nulo {
		formatar.ImprimirFormatado("Erro na execução da Máquina Virtual VVM: %v\n", errVM)
		so.Sair(1)
	}
}

funcao executarWasm(caminhoArquivo texto, destinoSaida texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo {
		formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
		so.Sair(1)
	}

	se destinoSaida == "" {
		se cordas.TemSufixo(caminhoArquivo, ".vamos") {
			destinoSaida = caminhoArquivo[:tamanho(caminhoArquivo)-6] + ".wasm"
		} senao {
			destinoSaida = caminhoArquivo + ".wasm"
		}
	}

	emissor := NovoEmissorWasm()
	bytesWasm, errWasm := emissor.CompilarAST(ast)
	se errWasm != nulo {
		formatar.ImprimirFormatado("Erro ao gerar módulo WebAssembly: %v\n", errWasm)
		so.Sair(1)
	}

	errSalvar := so.EscreverArquivo(destinoSaida, bytesWasm, 0644)
	se errSalvar != nulo {
		formatar.ImprimirFormatado("Erro ao salvar arquivo .wasm '%s': %v\n", destinoSaida, errSalvar)
		so.Sair(1)
	}

	formatar.ImprimirFormatado("✓ Módulo WebAssembly (.wasm) gerado com sucesso: %s (%d bytes)\n", destinoSaida, tamanho(bytesWasm))
}

funcao executarChecagemSemantica(caminhoArquivo texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo {
		formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
		so.Sair(1)
	}

	erros, avisos := ValidarAST(ast)
	se tamanho(avisos) > 0 {
		para _, aviso := intervalo avisos {
			formatar.ImprimirLinha(aviso)
		}
	}

	se tamanho(erros) > 0 {
		formatar.ImprimirFormatado("Falha na validação semântica de '%s': %d erro(s) encontrado(s):\n", caminhoArquivo, tamanho(erros))
		para _, errSem := intervalo erros {
			formatar.ImprimirFormatado("  ✗ %s\n", errSem)
		}
		so.Sair(1)
	}

	formatar.ImprimirFormatado("✓ Análise semântica estática aprovada: '%s' (0 erros)\n", caminhoArquivo)
}

funcao executarEmissaoC(caminhoArquivo texto, destinoSaida texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo {
		formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
		so.Sair(1)
	}

	emissor := NovoEmissorC()
	codigoC := emissor.CompilarAST(ast)

	se destinoSaida == "" {
		formatar.ImprimirLinha(codigoC)
		retornar
	}

	errSalvar := so.EscreverArquivo(destinoSaida, []byte(codigoC), 0644)
	se errSalvar != nulo {
		formatar.ImprimirFormatado("Erro ao salvar arquivo C '%s': %v\n", destinoSaida, errSalvar)
		so.Sair(1)
	}

	formatar.ImprimirFormatado("✓ Código-fonte C99 gerado com sucesso em: %s\n", destinoSaida)
}

funcao executarCompilacaoGCC(caminhoArquivo texto, destinoBinario texto) {
	se destinoBinario == "" {
		se cordas.TemSufixo(caminhoArquivo, ".vamos") {
			destinoBinario = caminhoArquivo[:tamanho(caminhoArquivo)-6]
		} senao {
			destinoBinario = "app"
		}
	}

	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo {
		formatar.ImprimirFormatado("Erro sintático: %v\n", errParse)
		so.Sair(1)
	}

	tempC := "/tmp/vamosc_temp_gcc.c"
	emissor := NovoEmissorC()
	codigoC := emissor.CompilarAST(ast)
	errG := so.EscreverArquivo(tempC, []byte(codigoC), 0644)
	se errG != nulo {
		formatar.ImprimirFormatado("Erro ao gravar arquivo temporário C: %v\n", errG)
		so.Sair(1)
	}

	errGCC := CompilarBinarioC(tempC, destinoBinario)
	so.Remover(tempC)

	se errGCC != nulo {
		formatar.ImprimirFormatado("Erro ao compilar com GCC: %v\n", errGCC)
		so.Sair(1)
	}

	formatar.ImprimirFormatado("✓ Executável binário nativo gerado com sucesso via GCC: %s\n", destinoBinario)
}

funcao executarTranspilacao(caminhoArquivo texto, destinoSaida texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	transpilador := NovoTranspilador(tokens)
	codigoGo := transpilador.Transpilar()

	se destinoSaida != "" {
		errGravacao := so.EscreverArquivo(destinoSaida, []byte(codigoGo), 0644)
		se errGravacao != nulo {
			formatar.ImprimirFormatado("Erro ao salvar arquivo em '%s': %v\n", destinoSaida, errGravacao)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ Transpilação concluída com sucesso! Arquivo gerado em: %s\n", destinoSaida)
	} senao {
		formatar.ImprimirLinha(codigoGo)
	}
}

funcao executarCompilacaoNativa(caminhoArquivo texto, destinoBinario texto) {
	se destinoBinario == "" {
		se cordas.TemSufixo(caminhoArquivo, ".vamos") {
			destinoBinario = caminhoArquivo[:tamanho(caminhoArquivo)-6]
		} senao {
			destinoBinario = "app"
		}
	}

	absDestino, errAbs := caminho.Absoluto(destinoBinario)
	se errAbs != nulo {
		absDestino = destinoBinario
	}

	dirFonte := caminho.Diretorio(caminhoArquivo)
	arquivosPacote, _ := caminho.Listar(caminho.Juntar(dirFonte, "*.vamos"))

	// Caso A: Pacote com múltiplos arquivos .vamos (ex: o próprio compilador/)
	se tamanho(arquivosPacote) > 1 {
		dirTemp := "/tmp/vamosc_build_ws"
		so.RemoverTodos(dirTemp)
		so.CriarDiretorio(dirTemp, 0755)

		para _, arq := intervalo arquivosPacote {
			dadosArq, errL := so.LerArquivo(arq)
			se errL == nulo {
				l := NovoAnalisadorLexico(texto(dadosArq))
				toks, _ := l.TokenizarTodos()
				t := NovoTranspilador(toks)
				goCod := t.Transpilar()
				nomeGo := cordas.Substituir(caminho.Base(arq), ".vamos", ".go", 1)
				_ = so.EscreverArquivo(caminho.Juntar(dirTemp, nomeGo), []byte(goCod), 0644)
			}
		}

		dadosMod, errMod := so.LerArquivo("go.mod")
		se errMod == nulo {
			_ = so.EscreverArquivo(caminho.Juntar(dirTemp, "go.mod"), dadosMod, 0644)
		} senao {
			_ = so.EscreverArquivo(caminho.Juntar(dirTemp, "go.mod"), []byte("module app\n\ngo 1.22\n"), 0644)
		}

		cmd := executar.Comando("go", "build", "-o", absDestino, ".")
		cmd.Dir = dirTemp
		saida, errCmd := cmd.SaidaCombinada()
		so.RemoverTodos(dirTemp)

		se errCmd != nulo {
			formatar.ImprimirFormatado("Erro na compilação nativa Go:\n%s\n", texto(saida))
			so.Sair(1)
		}

		formatar.ImprimirFormatado("✓ Pacote compilado com sucesso pelo 'vamosc': %s\n", destinoBinario)
		retornar
	}

	// Caso B: Arquivo único simples
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	transpilador := NovoTranspilador(tokens)
	codigoGo := transpilador.Transpilar()

	arquivoTemp := "/tmp/vamosc_temp.go"
	errGravar := so.EscreverArquivo(arquivoTemp, []byte(codigoGo), 0644)
	se errGravar != nulo {
		formatar.ImprimirFormatado("Erro ao gravar arquivo temporário: %v\n", errGravar)
		so.Sair(1)
	}

	cmd := executar.Comando("go", "build", "-o", absDestino, arquivoTemp)
	saida, errCmd := cmd.SaidaCombinada()
	so.Remover(arquivoTemp)

	se errCmd != nulo {
		formatar.ImprimirFormatado("Erro na compilação nativa Go:\n%s\n", texto(saida))
		so.Sair(1)
	}

	formatar.ImprimirFormatado("✓ Binário nativo gerado com sucesso pelo 'vamosc': %s\n", destinoBinario)
}

funcao executarExecucaoDireta(caminhoArquivo texto, progArgs []texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	lexer := NovoAnalisadorLexico(texto(dados))
	tokens, errLex := lexer.TokenizarTodos()
	se errLex != nulo {
		formatar.ImprimirFormatado("Erro léxico: %v\n", errLex)
		so.Sair(1)
	}

	transpilador := NovoTranspilador(tokens)
	codigoGo := transpilador.Transpilar()

	arquivoTemp := "/tmp/vamosc_run_temp.go"
	errGravar := so.EscreverArquivo(arquivoTemp, []byte(codigoGo), 0644)
	se errGravar != nulo {
		formatar.ImprimirFormatado("Erro ao gravar arquivo temporário: %v\n", errGravar)
		so.Sair(1)
	}

	argsCmd := criar([]texto, 0)
	argsCmd = anexar(argsCmd, "run")
	argsCmd = anexar(argsCmd, arquivoTemp)
	para _, a := intervalo progArgs {
		argsCmd = anexar(argsCmd, a)
	}

	cmd := executar.Comando("go", argsCmd...)
	saida, errCmd := cmd.SaidaCombinada()
	so.Remover(arquivoTemp)

	formatar.Imprimir(texto(saida))
	se errCmd != nulo {
		so.Sair(1)
	}
}

funcao executarFormatacaoArquivo(caminhoArquivo texto) {
	dados, err := so.LerArquivo(caminhoArquivo)
	se err != nulo {
		formatar.ImprimirFormatado("Erro ao abrir arquivo '%s': %v\n", caminhoArquivo, err)
		so.Sair(1)
	}

	formatado := FormatarCodigo(texto(dados))
	errGravar := so.EscreverArquivo(caminhoArquivo, []byte(formatado), 0644)
	se errGravar != nulo {
		formatar.ImprimirFormatado("Erro ao salvar arquivo formatado: %v\n", errGravar)
		so.Sair(1)
	}
	formatar.ImprimirFormatado("✓ Arquivo formatado com sucesso: %s\n", caminhoArquivo)
}

funcao executarAutoTeste() {
	formatar.ImprimirLinha("==> Executando Teste Interno de Auto-Hospedagem (Bootstrap G1/G2/G3)...")

	codigoFonte := `pacote principal
importar "formatar"

tipo Usuario estrutura {
	Nome texto
	Idade inteiro
}

funcao calcular(x inteiro, y inteiro) inteiro {
	retornar x + y
}

funcao principal() {
	u := Usuario{Nome: "VAMOS", Idade: 1}
	total := calcular(10, 32)
	se total == 42 {
		formatar.ImprimirLinha("Compilador VAMOS compilando a si mesmo!")
	}
}
`
	// 1. Teste Léxico
	lexer := NovoAnalisadorLexico(codigoFonte)
	tokens, err := lexer.TokenizarTodos()
	se err != nulo {
		formatar.ImprimirFormatado("Falha no teste léxico: %v\n", err)
		so.Sair(1)
	}

	// 2. Teste Sintático (Parser AST)
	parser := NovoAnalisadorSintatico(tokens)
	ast, errParse := parser.AnalisarPrograma()
	se errParse != nulo || ast == nulo {
		formatar.ImprimirFormatado("Falha no teste do parser sintático: %v\n", errParse)
		so.Sair(1)
	}
	se ast.TotalFilhos() == 0 {
		formatar.ImprimirLinha("Falha na validação dos nós da AST.")
		so.Sair(1)
	}

	// 3. Teste do Formatador
	codigoFormatado := FormatarCodigo(codigoFonte)
	se !cordas.Contem(codigoFormatado, "tipo Usuario estrutura") {
		formatar.ImprimirLinha("Falha no teste do formatador.")
		so.Sair(1)
	}

	// 4. Teste do Transpilador
	transpilador := NovoTranspilador(tokens)
	resultado := transpilador.Transpilar()

	se !cordas.Contem(resultado, "package main") || !cordas.Contem(resultado, "fmt.Println") {
		formatar.ImprimirLinha("Falha na validação do código Go gerado.")
		formatar.ImprimirLinha(resultado)
		so.Sair(1)
	}

	// 5. Teste de Emissão de Bytecode, Serialização e Execução na Máquina Virtual (VVM)
	emissor := NovoEmissorBytecode()
	progBytecode := emissor.CompilarAST(ast)
	se tamanho(progBytecode.Instrucoes) == 0 {
		formatar.ImprimirLinha("Falha na geração de bytecode VVM.")
		so.Sair(1)
	}

	serializado := progBytecode.Serializar()
	progRecarregado, errDes := DesserializarBytecode(serializado)
	se errDes != nulo || tamanho(progRecarregado.Instrucoes) != tamanho(progBytecode.Instrucoes) {
		formatar.ImprimirLinha("Falha na serialização/desserialização de bytecode VVM.")
		so.Sair(1)
	}

	vm := NovaMaquinaVirtual()
	errVM := vm.Interpretar(progRecarregado)
	se errVM != nulo {
		formatar.ImprimirFormatado("Falha na execução da Máquina Virtual VVM: %v\n", errVM)
		so.Sair(1)
	}

	// 6. Teste de Emissão Nativa WebAssembly (Wasm)
	emissorWasm := NovoEmissorWasm()
	bytesWasm, errWasm := emissorWasm.CompilarAST(ast)
	se errWasm != nulo || tamanho(bytesWasm) < 8 {
		formatar.ImprimirFormatado("Falha na geração nativa WebAssembly: %v\n", errWasm)
		so.Sair(1)
	}
	se bytesWasm[0] != 0x00 || bytesWasm[1] != 0x61 || bytesWasm[2] != 0x73 || bytesWasm[3] != 0x6D {
		formatar.ImprimirLinha("Falha no número mágico do cabeçalho WebAssembly.")
		so.Sair(1)
	}

	// 7. Teste de Análise Semântica e Verificação Estática de Tipos
	errosSem, _ := ValidarAST(ast)
	se tamanho(errosSem) > 0 {
		formatar.ImprimirFormatado("Falha na validação semântica do código válido: %v\n", errosSem)
		so.Sair(1)
	}

	codigoInvalido := `pacote principal
funcao teste() {
	x := 10
	x := 20
}
`
	lexInv := NovoAnalisadorLexico(codigoInvalido)
	toksInv, _ := lexInv.TokenizarTodos()
	parseInv := NovoAnalisadorSintatico(toksInv)
	astInv, _ := parseInv.AnalisarPrograma()
	errosInv, _ := ValidarAST(astInv)
	se tamanho(errosInv) == 0 {
		formatar.ImprimirLinha("Falha na detecção de erro semântico de variável duplicada.")
		so.Sair(1)
	}

	// 8. Teste de Emissão C Nativa (C99)
	emissorC := NovoEmissorC()
	codigoC := emissorC.CompilarAST(ast)
	se !cordas.Contem(codigoC, "#include <stdio.h>") || !cordas.Contem(codigoC, "int main(") {
		formatar.ImprimirLinha("Falha na geração de código C nativo.")
		so.Sair(1)
	}

	// 9. Teste do Otimizador de Bytecode (Constant Folding e Peephole Jumps)
	progOpt := NovoProgramaBytecode()
	id1 := progOpt.AdicionarConstante("15")
	id2 := progOpt.AdicionarConstante("4")
	progOpt.Emitir(OpConstante, id1, 1)
	progOpt.Emitir(OpConstante, id2, 1)
	progOpt.Emitir(OpMultiplicar, 0, 1) // 15 * 4 = 60
	progOpt.Emitir(OpSalto, 4, 2)       // Salto redundante para i+1 (4)
	progOpt.Emitir(OpRetornar, 0, 3)

	statsOpt := OtimizarBytecode(progOpt)
	se statsOpt.ConstantesDobradas < 1 || statsOpt.SaltosRedundantesRemovidos < 1 {
		formatar.ImprimirLinha("Falha na otimização de bytecode (Constant Folding/Jump Opt).")
		so.Sair(1)
	}
	se tamanho(progOpt.Instrucoes) != 2 {
		formatar.ImprimirFormatado("Falha na redução de instruções: esperava 2, obteve %d\n", tamanho(progOpt.Instrucoes))
		so.Sair(1)
	}

	formatar.ImprimirLinha("✓ 1. Análise léxica em VAMOS-LANG: APROVADA")
	formatar.ImprimirLinha("✓ 2. Parser sintático descendente recursivo (AST) em VAMOS-LANG: APROVADO")
	formatar.ImprimirLinha("✓ 3. Formatador automático em VAMOS-LANG: APROVADO")
	formatar.ImprimirLinha("✓ 4. Mapeamento e transpilação em VAMOS-LANG: APROVADOS")
	formatar.ImprimirLinha("✓ 5. Emissão de Bytecode e Máquina Virtual VVM em VAMOS-LANG: APROVADOS")
	formatar.ImprimirLinha("✓ 6. Emissão Nativa WebAssembly 1.0 (Wasm) em VAMOS-LANG: APROVADA")
	formatar.ImprimirLinha("✓ 7. Análise Semântica Estática e Tipos em VAMOS-LANG: APROVADA")
	formatar.ImprimirLinha("✓ 8. Emissão Nativa C (C99) para GCC/Clang em VAMOS-LANG: APROVADA")
	formatar.ImprimirLinha("✓ 9. Otimizador de Bytecode (Constant Folding & Peephole): APROVADO")
	formatar.ImprimirLinha("✓ Auto-teste de Bootstrapping (Etapas 1 a 10) concluído com 100% de êxito!")
}

funcao principal() {
	args := so.Argumentos[1:]
	se tamanho(args) == 0 {
		exibirAjuda()
		so.Sair(0)
	}

	comando := args[0]

	escolha comando {
	caso "--ajuda", "-h", "ajuda":
		exibirAjuda()
		so.Sair(0)

	caso "--versao", "-v", "versao":
		formatar.ImprimirFormatado("Compilador VAMOS-LANG (vamosc) versão %s\n", VersaoCompilador)
		so.Sair(0)

	caso "--auto-teste", "auto-teste":
		executarAutoTeste()
		so.Sair(0)

	caso "compilar", "build", "--compilar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para compilar.")
			so.Sair(1)
		}
		arquivo := args[1]
		destino := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destino = args[3]
		}
		executarCompilacaoNativa(arquivo, destino)
		so.Sair(0)

	caso "vm", "executar-vm", "--vm":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos ou .vamosb para executar na VM.")
			so.Sair(1)
		}
		executarVM(args[1])
		so.Sair(0)

	caso "bytecode", "desassemblar", "--bytecode", "--desassemblar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo para gerar/desassemblar o bytecode.")
			so.Sair(1)
		}
		destinoBytecode := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destinoBytecode = args[3]
		}
		executarBytecode(args[1], destinoBytecode)
		so.Sair(0)

	caso "otimizar", "--otimizar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo para otimizar o bytecode.")
			so.Sair(1)
		}
		destinoOpt := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destinoOpt = args[3]
		}
		executarOtimizacao(args[1], destinoOpt)
		so.Sair(0)

	caso "wasm", "--wasm":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para compilar em WebAssembly.")
			so.Sair(1)
		}
		destinoWasm := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destinoWasm = args[3]
		}
		executarWasm(args[1], destinoWasm)
		so.Sair(0)

	caso "checar", "--checar", "semantico", "--semantico":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para checar a semântica.")
			so.Sair(1)
		}
		executarChecagemSemantica(args[1])
		so.Sair(0)

	caso "c", "--c":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para gerar código C.")
			so.Sair(1)
		}
		destinoC := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destinoC = args[3]
		}
		executarEmissaoC(args[1], destinoC)
		so.Sair(0)

	caso "compilar-c", "--compilar-c":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para compilar via GCC.")
			so.Sair(1)
		}
		destinoBin := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destinoBin = args[3]
		}
		executarCompilacaoGCC(args[1], destinoBin)
		so.Sair(0)

	caso "rodar", "run", "--rodar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para executar.")
			so.Sair(1)
		}
		arquivo := args[1]
		progArgs := criar([]texto, 0)
		se tamanho(args) > 2 {
			progArgs = args[2:]
		}
		executarExecucaoDireta(arquivo, progArgs)
		so.Sair(0)

	caso "formatar", "fmt", "--formatar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para formatar.")
			so.Sair(1)
		}
		executarFormatacaoArquivo(args[1])
		so.Sair(0)

	caso "--tokens", "tokens":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para inspecionar tokens.")
			so.Sair(1)
		}
		inspecionarTokens(args[1])
		so.Sair(0)

	caso "--ast", "ast":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para gerar a AST.")
			so.Sair(1)
		}
		inspecionarAST(args[1])
		so.Sair(0)

	caso "--transpilar", "transpilar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o arquivo .vamos para transpilar.")
			so.Sair(1)
		}
		arquivo := args[1]
		destino := ""
		se tamanho(args) >= 4 && args[2] == "-o" {
			destino = args[3]
		}
		executarTranspilacao(arquivo, destino)
		so.Sair(0)

	padrao:
		// Se passou direto o arquivo .vamos
		se cordas.TemSufixo(comando, ".vamos") {
			destino := ""
			se tamanho(args) >= 3 && args[1] == "-o" {
				destino = args[2]
			}
			executarTranspilacao(comando, destino)
			so.Sair(0)
		}

		formatar.ImprimirFormatado("Comando não reconhecido: '%s'\n", comando)
		exibirAjuda()
		so.Sair(1)
	}
}
