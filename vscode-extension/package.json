{
  "name": "vamos-lang",
  "displayName": "VAMOS-LANG (Go em Português)",
  "description": "Suporte oficial à linguagem VAMOS-LANG: Realce de sintaxe, LSP inteligente, snippets e formatação para Go 100% em Português do Brasil.",
  "version": "1.1.0",
  "publisher": "vamos-lang",
  "icon": "icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:vamos"
  ],
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "vamos",
    "vamos-lang",
    "go",
    "golang",
    "portugues",
    "pt-br",
    "lsp"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vamos",
        "aliases": ["VAMOS-LANG", "vamos", "VAMOS"],
        "extensions": [".vamos"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "vamos",
        "scopeName": "source.vamos",
        "path": "./syntaxes/vamos.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vamos",
        "path": "./snippets/vamos.json"
      }
    ],
    "commands": [
      {
        "command": "vamos.runCurrentFile",
        "title": "VAMOS: Executar Arquivo Atual (vamos run)",
        "category": "VAMOS-LANG"
      },
      {
        "command": "vamos.buildCurrentFile",
        "title": "VAMOS: Compilar Binário (vamos build)",
        "category": "VAMOS-LANG"
      },
      {
        "command": "vamos.testWorkspace",
        "title": "VAMOS: Executar Testes (vamos test)",
        "category": "VAMOS-LANG"
      }
    ],
    "configuration": {
      "title": "VAMOS-LANG",
      "properties": {
        "vamos.lspPath": {
          "type": "string",
          "default": "vamos",
          "description": "Caminho para o binário da CLI do VAMOS-LANG que provê o servidor LSP."
        }
      }
    }
  }
}
