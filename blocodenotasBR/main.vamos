}

// ExibirNotaDetalhada imprime os detalhes de uma nota
funcao ExibirNotaDetalhada(n *Nota) {
	tagFav := "NÃO"
	se n.Favorita {
		tagFav = "SIM ★"
	}
	formatar.ImprimirLinha("┌──────────────────────────────────────────────────────────────────┐")
	formatar.ImprimirFormatado("│ NOTA #%03d - %-53s │\n", n.Id, n.Titulo)
	formatar.ImprimirLinha("├──────────────────────────────────────────────────────────────────┤")
	formatar.ImprimirFormatado("│ Categoria:      %-48s │\n", n.Categoria)
	formatar.ImprimirFormatado("│ Favorita:       %-48s │\n", tagFav)
	formatar.ImprimirFormatado("│ Criado em:      %-48s │\n", n.CriadoEm)
	formatar.ImprimirFormatado("│ Atualizado em:  %-48s │\n", n.AtualizadoEm)
	formatar.ImprimirLinha("├──────────────────────────────────────────────────────────────────┤")
	formatar.ImprimirLinha("│ CONTEÚDO:                                                        │")
	linhas := cordas.Dividir(n.Conteudo, "\n")
	para _, l := intervalo linhas {
		formatar.ImprimirFormatado("│ %-64s │\n", l)
	}
	formatar.ImprimirLinha("└──────────────────────────────────────────────────────────────────┘")
}

// ListarNotasTabela imprime uma lista elegante das notas
funcao ListarNotasTabela(notas []Nota) {
	se tamanho(notas) == 0 {
		formatar.ImprimirLinha("  (Nenhuma anotação encontrada)")
		retornar
	}

	formatar.ImprimirLinha("┌─────┬───┬──────────────────────────────┬──────────────┬─────────────────────┐")
	formatar.ImprimirLinha("│ ID  │ ★ │ TÍTULO                       │ CATEGORIA    │ DATA DE CRIAÇÃO     │")
	formatar.ImprimirLinha("├─────┼───┼──────────────────────────────┼──────────────┼─────────────────────┤")

	para _, n := intervalo notas {
		favIcon := " "
		se n.Favorita {
			favIcon = "★"
		}

		tit := n.Titulo
		se tamanho(tit) > 28 {
			tit = tit[:25] + "..."
		}

		cat := n.Categoria
		se tamanho(cat) > 12 {
			cat = cat[:9] + "..."
		}

		formatar.ImprimirFormatado(
			"│ %-3d │ %s │ %-28s │ %-12s │ %-19s │\n",
			n.Id,
			favIcon,
			tit,
			cat,
			n.CriadoEm,
		)
	}

	formatar.ImprimirLinha("└─────┴───┴──────────────────────────────┴──────────────┴─────────────────────┘")
	formatar.ImprimirFormatado("Total listado: %d nota(s)\n", tamanho(notas))
}

// ModoInterativo executa o console interativo para o usuário
funcao ModoInterativo(bloco *BlocoDeNotas) {
	ExibirBanner()
	formatar.ImprimirLinha("Modo Interativo Ativado! Digite 'ajuda' para comandos ou 'sair' para encerrar.")
	formatar.ImprimirLinha("--------------------------------------------------------------------")

	scanner := leitor.NewScanner(so.EntradaPadrao)

	para {
		formatar.Imprimir("\nbloco-notas-br> ")
		se !scanner.Scan() {
			interromper
		}

		linha := cordas.ApararEspaco(scanner.Text())
		se linha == "" {
			continuar
		}

		partes := cordas.Dividir(linha, " ")
		cmd := cordas.ParaMinusculas(partes[0])

		escolha cmd {
			caso "sair", "exit", "fechar":
			formatar.ImprimirLinha("Encerrando Bloco de Notas BR. Até logo!")
			retornar

			caso "ajuda", "help", "?":
			formatar.ImprimirLinha("Comandos Interativos:")
			formatar.ImprimirLinha("  criar        - Cria uma nova anotação interativamente")
			formatar.ImprimirLinha("  listar       - Lista todas as anotações")
			formatar.ImprimirLinha("  ver <id>     - Exibe detalhes de uma nota")
			formatar.ImprimirLinha("  buscar <txt> - Pesquisa notas por palavra")
			formatar.ImprimirLinha("  favoritar <id> - Alterna favorito")
			formatar.ImprimirLinha("  excluir <id> - Exclui uma nota")
			formatar.ImprimirLinha("  stats        - Exibe estatísticas do bloco")
			formatar.ImprimirLinha("  exportar <arq> - Exporta notas para arquivo de texto")
			formatar.ImprimirLinha("  sair         - Encerra a aplicação")

			caso "listar", "ls", "lista":
			ListarNotasTabela(bloco.Notas)

			caso "criar", "nova", "novo":
			formatar.Imprimir("Título da Nota: ")
			se !scanner.Scan() { interromper }
			titulo := cordas.ApararEspaco(scanner.Text())

			formatar.Imprimir("Categoria (ex: Pessoal, Trabalho, Estudos) [Geral]: ")
			se !scanner.Scan() { interromper }
			categoria := cordas.ApararEspaco(scanner.Text())

			formatar.Imprimir("Conteúdo da Nota: ")
			se !scanner.Scan() { interromper }
			conteudo := scanner.Text()

			nota, err := bloco.CriarNota(titulo, conteudo, categoria)
			se err != nulo {
				formatar.ImprimirLinha("❌ Erro ao criar nota:", err)
			} senao {
				formatar.ImprimirFormatado("✓ Nota #%d criada com sucesso com o título '%s'!\n", nota.Id, nota.Titulo)
			}

			caso "ver", "exibir", "mostrar":
			se tamanho(partes) < 2 {
				formatar.ImprimirLinha("Uso: ver <id>")
				continuar
			}
			id := textoParaInteiro(partes[1])
			nota, err := bloco.ObterNotaPorId(id)
			se err != nulo {
				formatar.ImprimirLinha("❌", err)
			} senao {
				ExibirNotaDetalhada(nota)
			}

			caso "buscar", "pesquisar", "procurar":
			se tamanho(partes) < 2 {
				formatar.ImprimirLinha("Uso: buscar <termo>")
				continuar
			}
			termo := cordas.Juntar(partes[1:], " ")
			resultados := bloco.BuscarNotas(termo)
			formatar.ImprimirFormatado("Resultados da busca por '%s':\n", termo)
			ListarNotasTabela(resultados)

			caso "favoritar", "fav", "star":
			se tamanho(partes) < 2 {
				formatar.ImprimirLinha("Uso: favoritar <id>")
				continuar
			}
			id := textoParaInteiro(partes[1])
			nota, err := bloco.AlternarFavorita(id)
			se err != nulo {
				formatar.ImprimirLinha("❌", err)
			} senao {
				se nota.Favorita {
					formatar.ImprimirFormatado("★ Nota #%d favoritada!\n", nota.Id)
				} senao {
					formatar.ImprimirFormatado("☆ Nota #%d desmarcada dos favoritos.\n", nota.Id)
				}
			}

			caso "excluir", "deletar", "remover", "rm":
			se tamanho(partes) < 2 {
				formatar.ImprimirLinha("Uso: excluir <id>")
				continuar
			}
			id := textoParaInteiro(partes[1])
			_, err := bloco.ExcluirNota(id)
			se err != nulo {
				formatar.ImprimirLinha("❌", err)
			} senao {
				formatar.ImprimirFormatado("✓ Nota #%d excluída com sucesso.\n", id)
			}

			caso "stats", "estatisticas", "metricas":
			total, favs, palavras, cats := bloco.ObterEstatisticas()
			formatar.ImprimirLinha("📊 Estatísticas do Bloco de Notas:")
			formatar.ImprimirFormatado("  • Total de Notas:     %d\n", total)
			formatar.ImprimirFormatado("  • Notas Favoritas:    %d\n", favs)
			formatar.ImprimirFormatado("  • Total de Palavras:  %d\n", palavras)
			formatar.ImprimirLinha("  • Categorias:")
			para cat, qtd := intervalo cats {
				formatar.ImprimirFormatado("      - %-15s: %d nota(s)\n", cat, qtd)
			}

			caso "exportar":
			destino := "notas_exportadas.txt"
			se tamanho(partes) >= 2 {
				destino = partes[1]
			}
			err := bloco.ExportarTexto(destino)
			se err != nulo {
				formatar.ImprimirLinha("❌ Erro na exportação:", err)
			} senao {
				formatar.ImprimirFormatado("✓ Notas exportadas com sucesso para '%s'!\n", destino)
			}

			padrao:
			formatar.ImprimirFormatado("Comando desconhecido: '%s'. Digite 'ajuda' para ver a lista de comandos.\n", cmd)
		}
	}
}

// Ponto de entrada principal
funcao principal() {
	args := so.Argumentos[1:]
	bloco := NovoBlocoDeNotas(ArquivoDadosPadrao)

	// Se nenhum argumento for passado, entra no modo interativo
	se tamanho(args) == 0 {
		ModoInterativo(bloco)
		retornar
	}

	comando := cordas.ParaMinusculas(args[0])

	escolha comando {
		caso "ajuda", "-h", "--help", "help":
		ExibirAjuda()

		caso "interativo", "menu", "repl":
		ModoInterativo(bloco)

		caso "criar", "adicionar", "novo", "nova":
		se tamanho(args) < 3 {
			formatar.ImprimirLinha("Erro: informe pelo menos título e conteúdo.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos criar \"Título\" \"Conteúdo\" [Categoria]")
			so.Sair(1)
		}
		titulo := args[1]
		conteudo := args[2]
		categoria := "Geral"
		se tamanho(args) >= 4 {
			categoria = args[3]
		}

		nota, err := bloco.CriarNota(titulo, conteudo, categoria)
		se err != nulo {
			formatar.ImprimirLinha("❌ Erro ao criar nota:", err)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ Nota #%d (\"%s\") criada com sucesso na categoria [%s]!\n", nota.Id, nota.Titulo, nota.Categoria)

		caso "listar", "ls", "lista":
		se tamanho(args) >= 2 {
			termo := args[1]
			resultados := bloco.BuscarNotas(termo)
			formatar.ImprimirFormatado("Listando notas filtradas por '%s':\n", termo)
			ListarNotasTabela(resultados)
		} senao {
			ListarNotasTabela(bloco.Notas)
		}

		caso "ver", "exibir", "mostrar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o ID da nota.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos ver <id>")
			so.Sair(1)
		}
		id := textoParaInteiro(args[1])
		nota, err := bloco.ObterNotaPorId(id)
		se err != nulo {
			formatar.ImprimirLinha("❌", err)
			so.Sair(1)
		}
		ExibirNotaDetalhada(nota)

		caso "editar", "atualizar":
		se tamanho(args) < 3 {
			formatar.ImprimirLinha("Erro: informe o ID e o novo conteúdo.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos editar <id> \"Novo Conteúdo\"")
			so.Sair(1)
		}
		id := textoParaInteiro(args[1])
		novoConteudo := args[2]
		nota, err := bloco.AtualizarNota(id, "", novoConteudo, "")
		se err != nulo {
			formatar.ImprimirLinha("❌ Erro ao atualizar nota:", err)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ Nota #%d atualizada com sucesso!\n", nota.Id)

		caso "categoria":
		se tamanho(args) < 3 {
			formatar.ImprimirLinha("Erro: informe o ID e a nova categoria.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos categoria <id> \"NovaCategoria\"")
			so.Sair(1)
		}
		id := textoParaInteiro(args[1])
		novaCat := args[2]
		nota, err := bloco.AtualizarNota(id, "", "", novaCat)
		se err != nulo {
			formatar.ImprimirLinha("❌ Erro:", err)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ Categoria da Nota #%d alterada para [%s]!\n", nota.Id, nota.Categoria)

		caso "favoritar", "fav":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o ID da nota.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos favoritar <id>")
			so.Sair(1)
		}
		id := textoParaInteiro(args[1])
		nota, err := bloco.AlternarFavorita(id)
		se err != nulo {
			formatar.ImprimirLinha("❌ Erro:", err)
			so.Sair(1)
		}
		se nota.Favorita {
			formatar.ImprimirFormatado("★ Nota #%d agora é FAVORITA!\n", nota.Id)
		} senao {
			formatar.ImprimirFormatado("☆ Nota #%d removida dos favoritos.\n", nota.Id)
		}

		caso "excluir", "deletar", "remover", "rm":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o ID da nota.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos excluir <id>")
			so.Sair(1)
		}
		id := textoParaInteiro(args[1])
		_, err := bloco.ExcluirNota(id)
		se err != nulo {
			formatar.ImprimirLinha("❌ Erro ao excluir nota:", err)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ Nota #%d excluída com sucesso!\n", id)

		caso "buscar", "pesquisar", "procurar":
		se tamanho(args) < 2 {
			formatar.ImprimirLinha("Erro: informe o termo de busca.")
			formatar.ImprimirLinha("Uso: vamos rodar blocodenotasBR/main.vamos buscar <termo>")
			so.Sair(1)
		}
		termo := cordas.Juntar(args[1:], " ")
		resultados := bloco.BuscarNotas(termo)
		formatar.ImprimirFormatado("Busca por '%s' (%d resultados):\n", termo, tamanho(resultados))
		ListarNotasTabela(resultados)

		caso "estatisticas", "stats", "resumo":
		total, favs, palavras, cats := bloco.ObterEstatisticas()
		ExibirBanner()
		formatar.ImprimirLinha("📊 Estatísticas Gerais do Bloco de Notas:")
		formatar.ImprimirFormatado("  • Total de Notas Cadastradas:    %d\n", total)
		formatar.ImprimirFormatado("  • Notas Marcadas como Favoritas: %d\n", favs)
		formatar.ImprimirFormatado("  • Estimativa Total de Palavras:  %d\n", palavras)
		formatar.ImprimirLinha("\n  • Distribuição por Categoria:")
		para cat, qtd := intervalo cats {
			formatar.ImprimirFormatado("      - [%-15s]: %d nota(s)\n", cat, qtd)
		}
		formatar.ImprimirLinha("====================================================================")

		caso "exportar":
		destino := "notas_exportadas.txt"
		se tamanho(args) >= 2 {
			destino = args[1]
		}
		err := bloco.ExportarTexto(destino)
		se err != nulo {
			formatar.ImprimirLinha("❌ Falha na exportação:", err)
			so.Sair(1)
		}
		formatar.ImprimirFormatado("✓ %d notas exportadas com sucesso para '%s'!\n", tamanho(bloco.Notas), destino)

		padrao:
		formatar.ImprimirFormatado("Comando '%s' não reconhecido.\n", comando)
		ExibirAjuda()
		so.Sair(1)
	}
}
