	ExibirBanner()
	formatar.ImprimirLinha("Uso via Linha de Comando (CLI):")
	formatar.ImprimirLinha("  vamos rodar blocodenotasBR/main.vamos <comando> [argumentos...]")
	formatar.ImprimirLinha("")
	formatar.ImprimirLinha("Comandos Disponíveis:")
	formatar.ImprimirLinha("  criar <titulo> <conteudo> [categoria]  Cria uma nova nota")
	formatar.ImprimirLinha("  listar [termo_ou_categoria]            Lista as notas cadastradas")
	formatar.ImprimirLinha("  ver <id>                               Exibe os detalhes de uma nota")
	formatar.ImprimirLinha("  editar <id> <novo_conteudo>            Atualiza o conteúdo de uma nota")
	formatar.ImprimirLinha("  categoria <id> <nova_categoria>        Altera a categoria de uma nota")
	formatar.ImprimirLinha("  favoritar <id>                         Marca ou desmarca como favorita")
	formatar.ImprimirLinha("  excluir <id>                           Remove permanentemente uma nota")
	formatar.ImprimirLinha("  buscar <termo>                         Pesquisa notas por palavra-chave")
	formatar.ImprimirLinha("  estatisticas                           Exibe métricas e dados do bloco")
	formatar.ImprimirLinha("  exportar <arquivo.txt>                 Exporta todas as notas em texto")
	formatar.ImprimirLinha("  interativo                             Inicia o console interativo")
	formatar.ImprimirLinha("  ajuda                                  Exibe esta ajuda")
	formatar.ImprimirLinha("")
	formatar.ImprimirLinha("Exemplos:")
	formatar.ImprimirLinha("  ./vamos rodar blocodenotasBR/main.vamos criar \"Ideia VAMOS\" \"Criar uma IDE web\" Trabalho")
	formatar.ImprimirLinha("  ./vamos rodar blocodenotasBR/main.vamos listar")
	formatar.ImprimirLinha("  ./vamos rodar blocodenotasBR/main.vamos buscar VAMOS")
	formatar.ImprimirLinha("  ./vamos rodar blocodenotasBR/main.vamos favoritar 1")
	formatar.ImprimirLinha("  ./vamos rodar blocodenotasBR/main.vamos estatisticas")
