// ============================================================================
// BLOCO DE NOTAS BR (BlocoDeNotasBR) - VAMOS-LANG
// Um gerenciador moderno, robusto e elegante de notas em Português do Brasil.
// ============================================================================

pacote principal

importar (
	"cordas"
	"formatar"
	"json"
	"leitor"
	"so"
	"tempo"
)

// Constantes do Sistema
constante (
	ArquivoDadosPadrao texto = "notas_db.json"
	VersaoApp          texto = "1.0.0"
	NomeApp            texto = "Bloco de Notas BR"
)

// Estrutura que representa uma anotação individual
tipo Nota estrutura {
	Id           inteiro  `json:"id"`
	Titulo       texto    `json:"titulo"`
	Conteudo     texto    `json:"conteudo"`
	Categoria    texto    `json:"categoria"`
	CriadoEm     texto    `json:"criado_em"`
	AtualizadoEm texto    `json:"atualizado_em"`
	Favorita     booleano `json:"favorita"`
}

// Estrutura principal do Bloco de Notas
tipo BlocoDeNotas estrutura {
	Notas         []Nota `json:"notas"`
	ProximoId     inteiro `json:"proximo_id"`
	ArquivoOrigem texto   `json:"-"`
}

// NovoBlocoDeNotas instancia um novo bloco e tenta carregar os dados persistidos
funcao NovoBlocoDeNotas(caminhoArquivo texto) *BlocoDeNotas {
	bloco := &BlocoDeNotas{
		Notas:         criar([]Nota, 0),
		ProximoId:     1,
		ArquivoOrigem: caminhoArquivo,
	}

	err := bloco.Carregar()
	se err != nulo {
		// Se o arquivo ainda não existir, inicia novo
		bloco.ProximoId = 1
	}

	retornar bloco
}

// Carregar lê os dados do arquivo JSON local
funcao (b *BlocoDeNotas) Carregar() erro {
	dados, err := so.LerArquivo(b.ArquivoOrigem)
	se err != nulo {
		retornar err
	}

	err = json.Deserializar(dados, b)
	se err != nulo {
		retornar err
	}

	// Ajusta o próximo ID disponível
	maiorId := 0
	para _, n := intervalo b.Notas {
		se n.Id > maiorId {
			maiorId = n.Id
		}
	}
	b.ProximoId = maiorId + 1

	retornar nulo
}

// Salvar persiste os dados em formato JSON formatado
funcao (b *BlocoDeNotas) Salvar() erro {
	bytesJson, err := json.SerializarIdentado(b, "", "  ")
	se err != nulo {
		retornar formatar.CriarErro("falha ao serializar notas: %v", err)
	}

	err = so.EscreverArquivo(b.ArquivoOrigem, bytesJson, 0644)
	se err != nulo {
		retornar formatar.CriarErro("falha ao salvar arquivo '%s': %v", b.ArquivoOrigem, err)
	}

	retornar nulo
}

// CriarNota adiciona uma nova anotação ao bloco
funcao (b *BlocoDeNotas) CriarNota(titulo texto, conteudo texto, categoria texto) (Nota, erro) {
	tituloLimpo := cordas.ApararEspaco(titulo)
	se tituloLimpo == "" {
		retornar Nota{}, formatar.CriarErro("o título da nota não pode ser vazio")
	}

	categoriaLimpa := cordas.ApararEspaco(categoria)
	se categoriaLimpa == "" {
		categoriaLimpa = "Geral"
	}

	dataHora := tempo.Agora().Formato("02/01/2006 15:04:05")

	novaNota := Nota{
		Id:           b.ProximoId,
		Titulo:       tituloLimpo,
		Conteudo:     conteudo,
		Categoria:    categoriaLimpa,
		CriadoEm:     dataHora,
		AtualizadoEm: dataHora,
		Favorita:     falso,
	}

	b.Notas = adicionar(b.Notas, novaNota)
	b.ProximoId++

	err := b.Salvar()
	se err != nulo {
		retornar novaNota, err
	}

	retornar novaNota, nulo
}

// ObterNotaPorId busca uma nota pelo seu identificador
funcao (b *BlocoDeNotas) ObterNotaPorId(id inteiro) (*Nota, erro) {
	para i := 0; i < tamanho(b.Notas); i++ {
		se b.Notas[i].Id == id {
			retornar &b.Notas[i], nulo
		}
	}
	retornar nulo, formatar.CriarErro("nota com ID %d não encontrada", id)
}

// AtualizarNota modifica os dados de uma nota existente
funcao (b *BlocoDeNotas) AtualizarNota(id inteiro, novoTitulo texto, novoConteudo texto, novaCategoria texto) (*Nota, erro) {
	para i := 0; i < tamanho(b.Notas); i++ {
		se b.Notas[i].Id == id {
			se cordas.ApararEspaco(novoTitulo) != "" {
				b.Notas[i].Titulo = cordas.ApararEspaco(novoTitulo)
			}
			se novoConteudo != "" {
				b.Notas[i].Conteudo = novoConteudo
			}
			se cordas.ApararEspaco(novaCategoria) != "" {
				b.Notas[i].Categoria = cordas.ApararEspaco(novaCategoria)
			}
			b.Notas[i].AtualizadoEm = tempo.Agora().Formato("02/01/2006 15:04:05")

			err := b.Salvar()
			se err != nulo {
				retornar nulo, err
			}
			retornar &b.Notas[i], nulo
		}
	}
	retornar nulo, formatar.CriarErro("nota com ID %d não encontrada para atualização", id)
}

// AlternarFavorita marca ou desmarca a nota como favorita
funcao (b *BlocoDeNotas) AlternarFavorita(id inteiro) (*Nota, erro) {
	para i := 0; i < tamanho(b.Notas); i++ {
		se b.Notas[i].Id == id {
			b.Notas[i].Favorita = !b.Notas[i].Favorita
			b.Notas[i].AtualizadoEm = tempo.Agora().Formato("02/01/2006 15:04:05")

			err := b.Salvar()
			se err != nulo {
				retornar nulo, err
			}
			retornar &b.Notas[i], nulo
		}
	}
	retornar nulo, formatar.CriarErro("nota com ID %d não encontrada", id)
}

// ExcluirNota remove uma nota da coleção
funcao (b *BlocoDeNotas) ExcluirNota(id inteiro) (booleano, erro) {
	indice := -1
	para i := 0; i < tamanho(b.Notas); i++ {
		se b.Notas[i].Id == id {
			indice = i
			interromper
		}
	}

	se indice == -1 {
		retornar falso, formatar.CriarErro("nota com ID %d não encontrada para exclusão", id)
	}

	// Remove item preservando a ordem
	b.Notas = adicionar(b.Notas[:indice], b.Notas[indice+1:]...)

	err := b.Salvar()
	se err != nulo {
		retornar falso, err
	}

	retornar verdadeiro, nulo
}

// BuscarNotas busca notas por palavra-chave no título, conteúdo ou categoria
funcao (b *BlocoDeNotas) BuscarNotas(termo texto) []Nota {
	termoMinusculo := cordas.ParaMinusculas(cordas.ApararEspaco(termo))
	se termoMinusculo == "" {
		retornar b.Notas
	}

	resultados := criar([]Nota, 0)
	para _, n := intervalo b.Notas {
		tit := cordas.ParaMinusculas(n.Titulo)
		cnt := cordas.ParaMinusculas(n.Conteudo)
		cat := cordas.ParaMinusculas(n.Categoria)

		se cordas.Contem(tit, termoMinusculo) || cordas.Contem(cnt, termoMinusculo) || cordas.Contem(cat, termoMinusculo) {
			resultados = adicionar(resultados, n)
		}
	}

	retornar resultados
}

// ContarPalavras conta o número aproximado de palavras em um texto
funcao ContarPalavras(s texto) inteiro {
	campos := cordas.Dividir(cordas.ApararEspaco(s), " ")
	total := 0
	para _, c := intervalo campos {
		se cordas.ApararEspaco(c) != "" {
			total++
		}
	}
	retornar total
}

// ObterEstatisticas calcula estatísticas detalhadas das notas
funcao (b *BlocoDeNotas) ObterEstatisticas() (totalNotas inteiro, totalFavoritas inteiro, totalPalavras inteiro, categorias mapa[texto]inteiro) {
	totalNotas = tamanho(b.Notas)
	totalFavoritas = 0
	totalPalavras = 0
	categorias = criar(mapa[texto]inteiro)

	para _, n := intervalo b.Notas {
		se n.Favorita {
			totalFavoritas++
		}
		totalPalavras = totalPalavras + ContarPalavras(n.Conteudo)
		categorias[n.Categoria] = categorias[n.Categoria] + 1
	}

	retornar totalNotas, totalFavoritas, totalPalavras, categorias
}

// ExportarTexto exporta todas as notas para um arquivo de texto limpo
funcao (b *BlocoDeNotas) ExportarTexto(caminhoDestino texto) erro {
	se tamanho(b.Notas) == 0 {
		retornar formatar.CriarErro("nenhuma nota disponível para exportar")
	}

	var sb cordas.Builder
	formatar.FimprimirLinha(&sb, "================================================================================")
	formatar.FimprimirLinha(&sb, "             RELATÓRIO DE NOTAS EXPORTADAS - BLOCO DE NOTAS BR                  ")
	formatar.FimprimirLinha(&sb, "================================================================================")
	formatar.FimprimirFormatado(&sb, "Data de Exportação: %s | Total de Notas: %d\n\n", tempo.Agora().Formato("02/01/2006 15:04:05"), tamanho(b.Notas))

	para _, n := intervalo b.Notas {
		tagFav := " "
		se n.Favorita {
			tagFav = "★"
		}
		formatar.FimprimirLinha(&sb, "--------------------------------------------------------------------------------")
		formatar.FimprimirFormatado(&sb, "[#%03d] %s [%s] - Categoria: %s\n", n.Id, tagFav, n.Titulo, n.Categoria)
		formatar.FimprimirFormatado(&sb, "Criado em: %s | Atualizado em: %s\n", n.CriadoEm, n.AtualizadoEm)
		formatar.FimprimirLinha(&sb, "Conteúdo:")
		formatar.FimprimirLinha(&sb, n.Conteudo)
		formatar.FimprimirLinha(&sb, "")
	}

	formatar.FimprimirLinha(&sb, "================================================================================")

	err := so.EscreverArquivo(caminhoDestino, []byte(sb.String()), 0644)
	se err != nulo {
		retornar formatar.CriarErro("falha ao exportar notas para '%s': %v", caminhoDestino, err)
	}

	retornar nulo
}

// Auxiliar para converter texto para número inteiro
funcao textoParaInteiro(s texto) inteiro {
	res := 0
	s = cordas.ApararEspaco(s)
	para i := 0; i < tamanho(s); i++ {
		se s[i] >= '0' && s[i] <= '9' {
			res = res*10 + inteiro(s[i]-'0')
		}
	}
	retornar res
}

// ExibirBanner imprime o banner de boas-vindas do Bloco de Notas BR
funcao ExibirBanner() {
	formatar.ImprimirLinha("====================================================================")
	formatar.ImprimirLinha("       📝 BLOCO DE NOTAS BR - GERENCIADOR EM VAMOS-LANG 🇧🇷          ")
	formatar.ImprimirFormatado("           Versão %s | Alta Performance com Sintaxe PT-BR          \n", VersaoApp)
	formatar.ImprimirLinha("====================================================================")
}

